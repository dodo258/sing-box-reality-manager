    url=$(jq -r '.assets[]?|select(.name=="srm")|.browser_download_url' "$tmp")
    digest=$(jq -r '.assets[]?|select(.name=="srm")|.digest // empty' "$tmp")
    rm -f "$tmp"
    if [[ -z $url ]]; then msg '发布仓库暂时没有独立脚本安装包，保留当前版本。'; return 0; fi
