}
# issue_certificate DOMAIN MODE [EMAIL] [WEBROOT] [force]: force requests one even
# while the current certificate is still valid.
issue_certificate() (
    local domain=$1 mode=$2 email=${3:-} webroot=${4:-} rc=0 probe
