    printf '%s' '"hysteria://\(uri_host):\(.port)?protocol=udp&auth=\(.password|@uri)&peer=\(.sni|@uri)&upmbps=30&downmbps=100&alpn=hysteria\(if pinned then "&insecure=1" else "" end)#\(.name|@uri)"'
}
