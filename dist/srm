#!/usr/bin/env bash
# SRM_BUNDLE
set -o pipefail
SRM_SELF=$(readlink -f -- "${BASH_SOURCE[0]}")
SRM_VERSION=4.0.0-dev
CORE_VERSION=1.14.1
SRM_REPO=dodo258/sing-box-reality-manager
SRM_ROOT=/opt/srm
DATA=/var/lib/srm
SERVICE=srm.service
# Daily version check (timer + oneshot service); never downloads or restarts.
CHECK_UNIT=srm-version-check
STATE=$DATA/current/state.json
CORE=$SRM_ROOT/core/sing-box
ACME=$SRM_ROOT/acme/acme.sh
# Color only for an interactive terminal; NO_COLOR or redirected output disables it.
use_color() { [[ -t 1 && -z ${NO_COLOR:-} && ${TERM:-dumb} != dumb ]]; }
err() { printf '错误：%s\n' "$*" >&2; }
msg() { printf '%s\n' "$*"; }
ask() {
    local prompt=$1 default=${2:-} answer
    printf '%s%s：' "$prompt" "${default:+ [$default]}" >&2
    IFS= read -r answer || return 1
    [[ $answer != 0 ]] || return 1
    REPLY=${answer:-$default}
}
# Non-interactive values come from command-line options; --yes accepts defaults.
# Callers set assume_yes; optional=1 allows an empty default without asking.
ask_opt() {
    local value=$1 prompt=$2 default=${3:-} optional=${4:-0}
    if [[ -n $value ]]; then REPLY=$value; return 0; fi
    if [[ ${assume_yes:-0} == 1 ]]; then
        [[ -n $default || $optional == 1 ]] || { err "非交互模式缺少参数：$prompt"; return 1; }
        REPLY=$default; return 0
    fi
    ask "$prompt" "$default"
}
# Reads one hidden line into REPLY; a last line without newline still counts.
read_secret() {
    local rc=0
    printf '%s：' "$1" >&2
    IFS= read -rs REPLY || [[ -n $REPLY ]] || rc=1
    printf '\n' >&2
    return "$rc"
}
yesno() { local answer; printf '%s [y/N]：' "$1" >&2; IFS= read -r answer && [[ $answer == y || $answer == Y ]]; }
random_hex() { openssl rand -hex "$1"; }
fetch() { curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error --retry 2 --connect-timeout 15 --max-time 180 "$1" -o "$2"; }
sha256() { if command -v sha256sum >/dev/null; then sha256sum "$1" | awk '{print $1}'; else shasum -a 256 "$1" | awk '{print $1}'; fi; }
require_root() { [[ $EUID == 0 ]] || { err '请以 root 运行。'; return 1; }; }
require_linux() {
    [[ $(uname -s) == Linux && $EUID == 0 ]] || { err '安装和管理需在 Linux 上以 root 运行。'; return 1; }
    [[ -d /run/systemd/system ]] || { err '需要 systemd。'; return 1; }
    [[ -r /etc/os-release ]] || return 1
    local ID
    . /etc/os-release
    case $ID in debian|ubuntu) ;; *) err '只支持 Debian/Ubuntu。'; return 1;; esac
}
with_lock() (
    require_linux || exit 1
    command -v flock >/dev/null || { err '缺少 flock（util-linux）。'; exit 1; }
    exec 9>/run/lock/srm.lock
    flock -n 9 || { err '另一项操作尚未结束，请稍后重试。'; exit 1; }
    recover_pending || exit 1
    "$@"
)
ensure_dependencies() {
    local pkg missing=()
    for pkg in ca-certificates curl jq openssl qrencode iproute2 util-linux tar; do
        dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q '^install ok installed$' || missing+=("$pkg")
    done
    if (( ${#missing[@]} )); then
        msg "安装缺失依赖：${missing[*]}"
        apt-get update && DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=l apt-get install -y --no-install-recommends "${missing[@]}" || return 1
    fi
    for pkg in curl jq openssl qrencode ss flock tar; do command -v "$pkg" >/dev/null || return 1; done
}
core_arch() {
    case $(uname -m) in x86_64) printf 'amd64\n';; aarch64|arm64) printf 'arm64\n';; *) err '只支持 amd64/arm64。'; return 1;; esac
}
# Version order for sing-box and the Snell server: 1.14.1 < 1.14.3; pre-releases (alpha,
# b/beta, rc; a bare "rc" counts as rc1) sort before their release.
version_latest() {
    printf '%s\n' "$@" | awk '{
        base = $0; stage = 3; num = 0
        if (match($0, /-?(alpha|beta|b|rc)\.?[0-9]*$/)) {
            suf = substr($0, RSTART); base = substr($0, 1, RSTART - 1)
            sub(/^-/, "", suf); sub(/\./, "", suf)
            if (suf ~ /^alpha/) stage = 0; else if (suf ~ /^b/) stage = 1; else stage = 2
            sub(/^[a-z]+/, "", suf); num = (suf == "" ? 1 : suf + 0)
        }
        split(base, p, ".")
        printf "%09d %09d %09d %d %09d %s\n", p[1], p[2], p[3], stage, num, $0
    }' | sort | tail -n 1 | awk '{print $NF}'
}
# True when NEW is a later version than OLD; an unreadable OLD counts as older.
version_newer() {
    local new=$1 old=$2 pattern='^[0-9]+\.[0-9]+\.[0-9]+'
    [[ $new =~ $pattern ]] || return 1
    [[ $old =~ $pattern ]] || return 0
    [[ $new != "$old" && $(version_latest "$new" "$old") == "$new" ]]
}
# Newest stable sing-box (1.14 or later): "VERSION SHA256" of this machine's Linux
# archive, the SHA256 being the asset digest GitHub's Release API reports.
# /releases/latest skips drafts and pre-releases; a payload that is one is refused.
core_release() {
    local tmp arch out=''
    arch=$(core_arch) || return 1
    tmp=$(mktemp) || return 1
    if fetch https://api.github.com/repos/SagerNet/sing-box/releases/latest "$tmp"; then
        out=$(jq -r --arg arch "$arch" 'select(.draft == false and .prerelease == false and (.tag_name|test("^v[0-9]+\\.[0-9]+\\.[0-9]+$")))
          | (.tag_name|ltrimstr("v")) as $v | .assets[]? | select(.name == "sing-box-\($v)-linux-\($arch).tar.gz")
          | select(.digest|test("^sha256:[a-f0-9]{64}$")) | "\($v) \(.digest|ltrimstr("sha256:"))"' "$tmp" 2>/dev/null) || out=''
    fi
    rm -f "$tmp"
    [[ $out =~ ^[0-9]+\.[0-9]+\.[0-9]+\ [a-f0-9]{64}$ ]] || { err '没有查到 sing-box 的稳定版发布信息（或缺少 SHA256）。'; return 1; }
    ! version_newer 1.14.0 "${out%% *}" || { err "sing-box ${out%% *} 低于最低支持的 1.14。"; return 1; }
    printf '%s\n' "$out"
}
# The release this script was tested with, pinned by archive SHA256.
core_pinned_hash() {
    case $(core_arch) in
      amd64) printf '12cb2816b52febb356f6a885b740cc8758c3f30b8ae0ca8edba80f0d2d35343f\n';;
      arm64) printf '6060b42fa84c5dcaeae1799af7f61b0f1ae4855d9d5ddc9e02baba17154b3ae2\n';;
      *) return 1;;
    esac
}
core_fetch() {
    local target=$1 version=$2 hash=$3 arch asset tmp
    arch=$(core_arch) || return 1
    asset=sing-box-$version-linux-$arch
    tmp=$(mktemp -d) || return 1
    if [[ $hash =~ ^[a-f0-9]{64}$ ]] &&
       fetch "https://github.com/SagerNet/sing-box/releases/download/v$version/$asset.tar.gz" "$tmp/core.tar.gz" &&
       [[ $(sha256 "$tmp/core.tar.gz") == "$hash" ]] &&
       tar -xzf "$tmp/core.tar.gz" -C "$tmp" "$asset/sing-box" &&
       install -m 755 "$tmp/$asset/sing-box" "$target"; then
        rm -rf "$tmp"; return 0
    fi
    rm -rf "$tmp"; err "sing-box $version 下载或 SHA256 校验失败。"; return 1
}
# Installation takes the newest stable release; without the Release API the tested one.
core_download() {
    local release
    if release=$(core_release); then core_fetch "$1" "${release% *}" "${release#* }"; return; fi
    msg "改为安装本脚本测试过的 sing-box $CORE_VERSION。"
    core_fetch "$1" "$CORE_VERSION" "$(core_pinned_hash)"
}
# Public address of this server as the internet sees it (IPv4 first) and its country
# code, looked up once when deploying; viewing nodes never needs it again.
PUBLIC_IP=''
PUBLIC_LOC=''
detect_public_ip() {
    [[ -z $PUBLIC_IP ]] || return 0
    local family out ip
    for family in 4 6; do
        out=$(curl "-$family" --proto '=https' --fail --silent --connect-timeout 5 --max-time 8 https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null) || continue
        ip=$(sed -n 's/^ip=//p' <<< "$out" | head -n 1)
        valid_ip "$ip" || continue
        PUBLIC_IP=$ip
        PUBLIC_LOC=$(sed -n 's/^loc=//p' <<< "$out" | head -n 1)
        # XX: unknown, T1: Tor.
        [[ $PUBLIC_LOC =~ ^[A-Z]{2}$ && $PUBLIC_LOC != XX && $PUBLIC_LOC != T1 ]] || PUBLIC_LOC=''
        return 0
    done
    return 1
}
resolve_domain() { getent ahosts "$1" 2>/dev/null | awk '{print $1}' | sort -u; }
# Checked before any certificate request, so a wrong DNS record is reported at once
# instead of as a failed Let's Encrypt validation. HOST is the node's address.
domain_resolves_here() {
    local domain=$1 host=$2 addresses mine address
    msg "检查域名 $domain 的解析…"
    addresses=$(resolve_domain "$domain") || addresses=''
    if [[ ! $host =~ ^[0-9.]+$ && $host != *:* ]]; then
        # A domain as the node address and no public IP to compare with (NAT, no
        # route to the lookup): nothing to check against, so it is not blocked.
        if ! detect_public_ip; then msg '没有查到本机公网 IP，无法确认域名解析，跳过检查。'; return 0; fi
        host=$PUBLIC_IP
    fi
    if [[ -z $addresses ]]; then
        err "域名 $domain 还没有解析记录：请在域名服务商添加 A 记录指向本机 $host，生效后再试。"; return 1
    fi
    mine=$(printf '%s\n' "$host" "$PUBLIC_IP"; ip -o addr show 2>/dev/null | awk '{sub(/\/.*/, "", $4); print $4}')
    while IFS= read -r address; do
        grep -Fxq -- "$address" <<< "$mine" && return 0
    done <<< "$addresses"
    err "域名 $domain 解析到 $(paste -sd ' ' - <<< "$addresses")，不是本机 $host：请把 A 记录改成本机 IP（Cloudflare 要关掉代理，设为「仅 DNS」），生效后再试。"
    return 1
}
port_free() {
    local port=$1 exclude=${2:-} output
    valid_port "$port" || return 1
    if [[ -f $STATE ]]; then
        jq -e --arg id "$exclude" --argjson port "$port" 'any(.nodes[]; (.id!=$id and .port==$port) or .local_port==$port)' "$STATE" >/dev/null && return 1
    fi
    output=$(ss -H -lntu "sport = :$port") || return 1
    [[ -z $output ]]
}
choose_port() {
    local candidate i
    for ((i=0; i<100; i++)); do
        candidate=$(od -An -N4 -tu4 /dev/urandom | tr -d ' ')
        candidate=$((candidate % 40001 + 10000))
        if port_free "$candidate"; then printf '%s\n' "$candidate"; return 0; fi
    done
    err '未找到空闲端口。'; return 1
}
# Configuration is generated from one root-owned state file, never edited in-place.
# Protocol-specific fields are validated and rendered through lib/protocols.sh.
STATE_SCHEMA=2
empty_state() { printf '%s\n' '{"schema":2,"nodes":[],"policies":[],"unlock_dns":null,"egress":null}'; }
# Older state is upgraded one schema at a time whenever it is about to change;
# the result goes to stdout and the input file is left untouched.
#   1 → 2: policies may carry "inbounds" (node ids); nodes stay exactly the same.
state_migrate_1() { jq '.schema = 2'; }
state_upgrade() {
    local json schema
    json=$(jq -c . "$1") && schema=$(jq -r '.schema|tojson' <<< "$json") || { err '节点数据无法读取，未改动。'; return 1; }
    while [[ $schema != "$STATE_SCHEMA" ]]; do
        [[ $schema =~ ^[1-9][0-9]*$ ]] && (( schema < STATE_SCHEMA )) && declare -F "state_migrate_$schema" >/dev/null ||
            { err "节点数据版本 $schema 不受支持（可能来自更新版本的脚本），未改动。"; return 1; }
        json=$("state_migrate_$schema" <<< "$json") && schema=$(jq -r '.schema|tojson' <<< "$json") || return 1
    done
    printf '%s\n' "$json"
}
valid_port() { [[ $1 =~ ^[1-9][0-9]{0,4}$ ]] && (( $1 <= 65535 )); }
valid_domain() {
    [[ ${#1} -le 253 && $1 == *.* && $1 != *..* && $1 =~ ^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?$ ]] || return 1
    local label
    local IFS=.
    for label in $1; do
        [[ ${#label} -le 63 && $label != -* && $label != *- ]] || return 1
    done
}
valid_ip() {
    local address=$1 part compressed=0 count=0 rest
    if [[ $address =~ ^[0-9.]+$ ]]; then
        [[ $address != .* && $address != *. && $address != *..* ]] || return 1
        local IFS=.
        for part in $address; do
            [[ $part =~ ^[0-9]{1,3}$ ]] && ((10#$part <= 255)) || return 1
            count=$((count+1))
        done
        [[ $count == 4 ]]; return
    fi
    [[ $address == *:* && $address =~ ^[0-9a-fA-F:]+$ && $address != *:::* ]] || return 1
    if [[ $address == *::* ]]; then compressed=1; rest=${address#*::}; [[ $rest != *::* ]] || return 1
    else [[ $address != :* && $address != *: ]] || return 1; fi
    local IFS=:
    for part in $address; do
        [[ -n $part ]] || continue
        [[ ${#part} -le 4 ]] || return 1
        count=$((count+1))
    done
    if [[ $compressed == 1 ]]; then ((count<8)); else ((count==8)); fi
}
valid_host() {
    if [[ $1 =~ ^[0-9.]+$ || $1 == *:* ]]; then valid_ip "$1"; else valid_domain "$1"; fi
}
validate_state() {
    jq -e "$PROTO_JQ_DEFS"'
      def text: type == "string" and length > 0 and (test("[\\x00-\\x1f\\x7f]")|not);
      [.nodes[]?.id] as $ids |
      .schema == 2 and (.nodes|type == "array") and (.policies|type == "array") and
      ([.policies[].name]|length == (unique|length)) and
      ([.nodes[].id]|length == (unique|length)) and
      # Node ports and the loopback ports of helper services never overlap.
      ([.nodes[]|.port, (.local_port // empty)]|length == (unique|length)) and
      all(.nodes[];
        (.id|test("^[a-f0-9]{16}$")) and (.name|text) and
        (.host|text) and (.sni == null or (.sni|text)) and ((.listen // "::") == "::" or .listen == "0.0.0.0") and (.enabled|type == "boolean") and
        (.port|type == "number" and floor == . and . >= 1 and . <= 65535) and
        ('"$(proto_jq validate false)"')) and
      all(.policies[];
        (.name|text) and (.mode == "dns" or .mode == "proxy") and
        (.domains|type == "array" and length > 0) and
        all(.domains[]; text and test("^[a-z0-9][a-z0-9.-]*[a-z0-9]$")) and
        # Optional: limit the rule to these nodes; absent means every node.
        (.inbounds == null or (.inbounds|type == "array" and length > 0 and length == (unique|length) and
          all(.[]; . as $i | any($ids[]; . == $i))))) and
      ((any(.policies[]; .mode == "dns")|not) or (.unlock_dns|type == "string" and length > 0)) and
      ((any(.policies[]; .mode == "proxy")|not) or (.egress|type == "object")) and
      (.egress == null or (.egress.type == "socks" and .egress.version == "5" and
        (.egress.server|text) and (.egress.server_port|type == "number" and floor == . and . > 0 and . <= 65535)))
    ' "$1" >/dev/null || { err '节点数据格式不合法，未应用。'; return 1; }
    local h
    h=$(jq -r '.unlock_dns // empty' "$1")
    [[ -z $h ]] || valid_ip "$h" || { err '解锁 DNS IP 无效。'; return 1; }
    while IFS= read -r h; do valid_host "$h" || { err "地址不合法：$h"; return 1; }; done < <(jq -r '.nodes[].host, (.egress.server // empty)' "$1")
    while IFS= read -r h; do valid_domain "$h" || { err "域名不合法：$h"; return 1; }; done < <(jq -r '.nodes[].sni // empty, .policies[].domains[]' "$1")
}
render_config() {
    validate_state "$1" || return 1
    jq "$PROTO_JQ_DEFS"'
      # A policy limited to some nodes matches only traffic entering through their inbounds.
      def scope: if .inbounds then {inbound:.inbounds} else {} end;
      . as $s |
      [.policies[]|select(.mode=="dns")] as $dns |
      [.policies[]|select(.mode=="proxy")] as $proxy |
      {
        log: {level:"warn",timestamp:true},
        dns: {
          servers: ([{type:"local",tag:"local"}]
            + (if ($dns|length)>0 then [{type:"udp",tag:"unlock",server:$s.unlock_dns,server_port:53}] else [] end)
            + (if ($proxy|length)>0 then [{type:"https",tag:"remote-dns",server:"1.1.1.1",detour:"media-proxy"}] else [] end)),
          rules: ([$proxy[]|scope + {domain_suffix:.domains,action:"route",server:"remote-dns"}]
            + [$dns[]|scope + {domain_suffix:.domains,action:"route",server:"unlock"}]),
          final:"local"
        },
        inbounds: [$s.nodes[]|select(.enabled)|('"$(proto_jq render_inbound '[]')"')[]],
        outbounds: ([{type:"direct",tag:"direct"}]
          + (if ($proxy|length)>0 then [$s.egress + {tag:"media-proxy",domain_resolver:"local"}] else [] end)),
        route: {default_domain_resolver:"local",final:"direct",rules: (
          [{action:"sniff",timeout:"300ms"},{protocol:"dns",action:"hijack-dns"}]
          + [$proxy[]|scope + {domain_suffix:.domains,action:"route",outbound:"media-proxy"}]
          + [$dns[]|(scope + {domain_suffix:.domains,action:"resolve",server:"unlock",strategy:"ipv4_only"}),
                    (scope + {domain_suffix:.domains,action:"route",outbound:"direct"})])
        }
      }
    ' "$1"
}
node_json() { jq -e --arg id "$2" '.nodes[]|select(.id==$id)' "$1"; }
client_outbound() { jq "$PROTO_JQ_DEFS $(proto_jq client_outbound 'error("不支持的协议：\(.type)")')"; }
share_uri() { jq -r "$PROTO_JQ_DEFS $(proto_jq share_uri 'error("不支持的协议：\(.type)")')"; }
# Client snippets; empty output when the client has no support for the protocol.
clash_proxy() { jq -r "$PROTO_JQ_DEFS $(proto_jq clash empty)|\"- \(tojson)\""; }
surge_proxy() { jq -r "$PROTO_JQ_DEFS $(proto_jq surge empty)"; }
# The Surge line on stdin as the fields of Surge's new-proxy form, one per line.
surge_form() { jq -Rr "$SURGE_FORM_JQ"; }
client_note() { jq -r "$PROTO_JQ_DEFS $(proto_jq note empty)"; }
# Protocol registry. Each protocol is one block of proto_<type>_<hook> functions;
# other modules dispatch through proto_call / proto_jq and never match on types.
#   label            display name
#   transport        "tcp", "udp" or "tcp udp", used by firewall rules and health checks
#   validate         jq boolean for the protocol's own node fields (def text available)
#   render_inbound   jq array of sing-box server inbounds for one node
#   share_uri        jq string: raw share link (Shadowrocket, v2rayN and others import it),
#                    in the format of the protocol's official or de facto standard (linked
#                    above each one) and with only the parameters that standard defines
#   client_outbound  jq object: sing-box client outbound
#   secrets          jq paths hidden from node details
#   domain           none | optional | required: whether the protocol needs a domain for a
#                    certificate (optional: a self-signed certificate without one)
#   link_clients     apps that import the raw share link (Shadowrocket v2rayN), empty for none
#   prompt           set protocol options from node_add's opt_* variables or their defaults
#                    (no questions); sets sni (empty when unused or picked at create)
#   create           generate credentials after confirmation; REPLY = JSON fields
#   rotate           new credentials; REPLY = JSON fields to merge into the node
# Optional: clash (jq object: Clash Meta / mihomo proxy), surge (jq string: Surge proxy line),
# note (jq string shown with the client snippets), hint (text in the quick-deploy list),
# variant (the protocol's one menu question; sets node_add's opt_* variables), retarget_label / retarget_select /
# retarget (change a TLS handshake target), and the sidecar pair for a protocol served
# by its own program next to sing-box: sidecar (jq string: systemd unit of the node,
# which listens on 127.0.0.1:.local_port) and sidecar_render NODE DIR (writes the
# node's files into the generation, so switching generations switches them too).
# A protocol whose server program srm downloads adds the program group, used by the
# version check and manual updates: program_label (name shown to users), program_key
# (jq string: the program variant a node runs, e.g. "v6"), program_path KEY,
# program_current KEY (installed version), program_latest KEY… (one network lookup;
# prints KEY<TAB>VERSION lines) and program_fetch KEY VERSION TARGET (download and verify).
# Moving v3 installations (lib/migrate.sh), all optional: v3_import INBOUND (one inbound
# of v3's sing-box configuration: returns 0 with REPLY = the node's protocol fields, 1
# when the inbound is another protocol's, 2 when it is this protocol's but cannot move,
# REPLY = the reason; the first user is taken and certificates are handled by the
# migration), v3_scan ROOT (nodes v3 kept in files of their own: one JSON line each,
# {label, units, node} or {label, units, skip}, optional note) and v3_prepare NODE
# (install what the node needs before it starts, e.g. a server program).
PROTO_HOOKS='label transport domain link_clients validate render_inbound share_uri client_outbound secrets prompt create rotate'
PROTOCOLS=''
# First page of the quick-deploy list, in this order; the rest are under 「更多协议」.
QUICK_PROTOCOLS='vless hysteria2 snell anytls'
PROTO_JQ_DEFS='
  def base_inbound: {tag:.id,listen:(.listen // "::"),listen_port:.port};
  def base_outbound: {tag:.name,server:.host,server_port:.port};
  def uri_host: if (.host|contains(":")) then "["+.host+"]" else .host end;
  def tls_files: {certificate_path:(.cert_dir+"/fullchain.pem"),key_path:(.cert_dir+"/key.pem")};
  # Self-signed nodes carry their certificate hashes; clients pin them instead of trusting a CA.
  def pinned: .cert_sha256 != null;
  def tls_client: {enabled:true,server_name:.sni} + (if pinned then {certificate_public_key_sha256:[.pubkey_sha256]} else {} end);
  def clash_base: {name:.name,server:.host,port:.port};
  def clash_pin: if pinned then {fingerprint:.cert_sha256} else {} end;
  def surge_head($type): "\(.name|gsub("[,=]";" ")) = \($type), \(.host), \(.port)";
  def surge_pin: if pinned then ", server-cert-fingerprint-sha256=\(.cert_sha256)" else "" end;
  # ws early data in the Sec-WebSocket-Protocol header, kept for nodes moved from v3
  # whose sing-box clients send it; clients without early data still connect.
  def early_data_server: if .early_data then {max_early_data:2048,early_data_header_name:"Sec-WebSocket-Protocol"} else {} end;
'
# Surge for iOS documents no way to import one proxy (manual.nssurge.com/tools/url-scheme.html
# lists install-config and install-module only; a whole profile from a URL), so phone
# users fill in the new-proxy form. The manual does not name that form's fields: each
# line gives a Chinese name and, unless they match, the parameter name of the Surge line.
# Input: the line; quoted values (passwords) may contain commas.
SURGE_FORM_JQ='
  {psk:"PSK",version:"版本",mode:"模式",reuse:"连接复用",password:"密码",username:"用户名（UUID）",uuid:"UUID",
   sni:"SNI",alpn:"ALPN","encrypt-method":"加密方式","udp-relay":"UDP 转发",tls:"TLS",ws:"WebSocket",
   "ws-path":"WebSocket 路径","ws-headers":"WebSocket 请求头","vmess-aead":"VMess AEAD",
   "server-cert-fingerprint-sha256":"证书 SHA-256 指纹","shadow-tls-password":"Shadow TLS 密码",
   "shadow-tls-sni":"Shadow TLS SNI","shadow-tls-version":"Shadow TLS 版本"} as $names |
  index(" = ") as $i | [.[$i+3:]|scan("(?:\"[^\"]*\"|[^,])+")|ltrimstr(" ")] as $f |
  "  名称：\(.[:$i])", "  类型：\($f[0])", "  服务器：\($f[1])", "  端口：\($f[2])",
  ($f[3:][]|index("=") as $j|.[:$j] as $k|(.[$j+1:]|ltrimstr("\"")|rtrimstr("\"")) as $v|
   "  \(($names[$k] // $k) as $n|if ($n|ascii_downcase) == $k then $n else "\($n)（\($k)）" end)：\(if $v == "true" then "开" elif $v == "false" then "关" else $v end)")
'
proto_register() {
    local type=$1 hook
    [[ $type =~ ^[a-z][a-z0-9]*$ ]] || { err "协议名不合法：$type"; return 1; }
    for hook in $PROTO_HOOKS; do
        declare -F "proto_${type}_$hook" >/dev/null || { err "协议 $type 缺少 proto_${type}_$hook，未注册。"; return 1; }
    done
    # Optional hooks come as a complete group or not at all.
    local optional=0
    for hook in retarget retarget_select retarget_label; do declare -F "proto_${type}_$hook" >/dev/null && optional=$((optional+1)); done
    (( optional == 0 || optional == 3 )) || { err "协议 $type 的 retarget 钩子不完整，未注册。"; return 1; }
    optional=0
    for hook in sidecar sidecar_render; do declare -F "proto_${type}_$hook" >/dev/null && optional=$((optional+1)); done
    (( optional == 0 || optional == 2 )) || { err "协议 $type 的 sidecar 钩子不完整，未注册。"; return 1; }
    optional=0
    for hook in program_label program_key program_path program_current program_latest program_fetch; do declare -F "proto_${type}_$hook" >/dev/null && optional=$((optional+1)); done
    (( optional == 0 || optional == 6 )) || { err "协议 $type 的 program 钩子不完整，未注册。"; return 1; }
    proto_known "$type" || PROTOCOLS="${PROTOCOLS:+$PROTOCOLS }$type"
}
proto_known() { [[ $1 =~ ^[a-z][a-z0-9]*$ && " $PROTOCOLS " == *" $1 "* ]]; }
proto_call() {
    local type=$1 hook=$2
    shift 2
    proto_known "$type" || { err "不支持的协议：${type:-空}（可选：$PROTOCOLS）"; return 1; }
    declare -F "proto_${type}_$hook" >/dev/null || { err "协议 $type 不支持此操作。"; return 1; }
    "proto_${type}_$hook" "$@"
}
proto_has() { proto_known "$1" && declare -F "proto_$1_$2" >/dev/null; }
# Builds `if .type=="a" then (<a hook>) elif … else <fallback> end` for jq;
# protocols without an optional hook fall through to the fallback.
proto_jq() {
    local hook=$1 fallback=$2 type out='' keyword=if
    for type in $PROTOCOLS; do
        declare -F "proto_${type}_$hook" >/dev/null || continue
        out+="$keyword .type==\"$type\" then ($("proto_${type}_$hook")) "
        keyword=elif
    done
    if [[ -z $out ]]; then printf '%s' "$fallback"; else printf '%s else %s end' "$out" "$fallback"; fi
}
# Transports as a jq array expression, e.g. ["tcp","udp"], for firewall and listener checks.
proto_jq_transports() {
    local type out='' keyword=if
    for type in $PROTOCOLS; do
        out+="$keyword .type==\"$type\" then (\"$("proto_${type}_transport")\"|split(\" \")) "
        keyword=elif
    done
    printf '%s else ["tcp"] end' "$out"
}
proto_by_index() {
    local type i=0
    for type in $PROTOCOLS; do
        i=$((i+1))
        [[ $1 != "$i" ]] || { printf '%s\n' "$type"; return 0; }
    done
    return 1
}
# All labels, or only the first N followed by the total count.
proto_labels() {
    local type out='' count=0
    for type in $PROTOCOLS; do
        count=$((count+1))
        [[ -n ${1:-} ]] && (( count > $1 )) && continue
        out+="${out:+ · }$("proto_${type}_label")"
    done
    if [[ -n ${1:-} ]] && (( count > $1 )); then out+=" 等 $count 种协议"; fi
    printf '%s\n' "$out"
}

# --- VLESS Reality -----------------------------------------------------------
REALITY_TARGETS='www.ctrip.com www.ixigua.com'
proto_vless_label() { printf 'VLESS Reality'; }
proto_vless_transport() { printf 'tcp'; }
proto_vless_domain() { printf 'none'; }
proto_vless_link_clients() { printf 'Shadowrocket v2rayN'; }
proto_vless_hint() { printf '推荐 · 不需要域名 · 回车即可'; }
proto_vless_validate() {
    printf '%s' '(.sni|text) and (.uuid|test("^[a-f0-9-]{36}$")) and (.private_key|text) and (.public_key|text) and (.short_id|test("^[a-f0-9]{16}$"))'
}
proto_vless_render_inbound() {
    printf '%s' '[base_inbound + {type:"vless",users:[{uuid:.uuid,flow:"xtls-rprx-vision"}],tls:{enabled:true,server_name:.sni,reality:{enabled:true,handshake:{server:.sni,server_port:443},private_key:.private_key,short_id:[.short_id]}}}]'
}
# VLESS links: XTLS/Xray-core discussion #716 (github.com/XTLS/Xray-core/discussions/716),
# no "/" before "?"; REALITY needs fp and pbk, sid and flow are its own fields.
proto_vless_share_uri() {
    printf '%s' '"vless://\(.uuid)@\(uri_host):\(.port)?encryption=none&security=reality&type=tcp&flow=xtls-rprx-vision&fp=chrome&sni=\(.sni|@uri)&pbk=\(.public_key|@uri)&sid=\(.short_id)#\(.name|@uri)"'
}
proto_vless_client_outbound() {
    printf '%s' 'base_outbound + {type:"vless",uuid:.uuid,flow:"xtls-rprx-vision",tls:{enabled:true,server_name:.sni,utls:{enabled:true,fingerprint:"chrome"},reality:{enabled:true,public_key:.public_key,short_id:.short_id}}}'
}
proto_vless_clash() {
    printf '%s' 'clash_base + {type:"vless",uuid:.uuid,network:"tcp",tls:true,udp:true,flow:"xtls-rprx-vision",servername:.sni,
      "reality-opts":{"public-key":.public_key,"short-id":.short_id},"client-fingerprint":"chrome"}'
}
proto_vless_secrets() { printf '%s' '.uuid,.private_key,.public_key,.short_id'; }
proto_vless_prompt() { handshake_target_prompt; }
proto_vless_create() {
    local pair private public uuid short
    handshake_target_ready || return 1
    pair=$("$CORE" generate reality-keypair) || return 1
    private=$(printf '%s\n' "$pair" | awk '/PrivateKey:/{print $2}')
    public=$(printf '%s\n' "$pair" | awk '/PublicKey:/{print $2}')
    # Every node gets its own shortId; nothing is shared between deployments.
    uuid=$("$CORE" generate uuid) && short=$(random_hex 8) || return 1
    REPLY=$(jq -nc --arg uuid "$uuid" --arg private "$private" --arg public "$public" --arg short "$short" \
        '{uuid:$uuid,private_key:$private,public_key:$public,short_id:$short}')
}
proto_vless_rotate() {
    local uuid
    uuid=$("$CORE" generate uuid) || return 1
    REPLY=$(jq -nc --arg v "$uuid" '{uuid:$v}')
}
proto_vless_retarget_label() { printf '切换 Reality 目标（携程 / 西瓜视频）'; }
proto_vless_retarget_select() { reality_target_select; }
# REPLY = JSON fields to merge, or empty when the node already uses the target.
proto_vless_retarget() { handshake_retarget "$@"; }
# v3 Reality: the handshake server is the SNI, and v3 links use its fixed non-empty
# shortId, which the node keeps so clients need no change.
proto_vless_v3_import() {
    local in=$1 public
    jq -e '.type == "vless" and .tls.reality.enabled == true' <<< "$in" >/dev/null || return 1
    if ! jq -e '.transport == null' <<< "$in" >/dev/null; then
        REPLY="v4 的 Reality 只支持 TCP Vision，不支持 $(jq -r '.transport.type' <<< "$in") 传输"; return 2
    fi
    # srm uses one name for the handshake target and the SNI clients send.
    jq -e '(.tls.reality.handshake.server_port // 443) == 443 and .tls.reality.handshake.server == .tls.server_name and .users[0].flow == "xtls-rprx-vision"' <<< "$in" >/dev/null ||
        { REPLY='握手目标不是「SNI 同名域名:443」或没有 Vision 流控，v4 不支持'; return 2; }
    REPLY=$(jq -c '{sni:.tls.reality.handshake.server,uuid:(.users[0].uuid|ascii_downcase),private_key:.tls.reality.private_key,
        short_id:([.tls.reality.short_id[]?|select(test("^[a-f0-9]{16}$"))][0])}' <<< "$in") || return 1
    jq -e '.short_id and (.private_key|type == "string")' <<< "$REPLY" >/dev/null || { REPLY='缺少 16 位 shortId 或私钥'; return 2; }
    public=$(reality_public_key "$(jq -r .private_key <<< "$REPLY")") || { REPLY='私钥无法读取'; return 2; }
    REPLY=$(jq -c --arg p "$public" '. + {public_key:$p}' <<< "$REPLY")
}
# X25519 public key of a Reality private key (both base64url without padding): the raw
# key is wrapped in its PKCS#8 header so openssl can derive the public half.
reality_public_key() {
    local key out
    key=$(printf '%s' "$1" | tr '_-' '/+')
    [[ $key =~ ^[A-Za-z0-9+/]{43}$ ]] || return 1
    out=$({ printf '\x30\x2e\x02\x01\x00\x30\x05\x06\x03\x2b\x65\x6e\x04\x22\x04\x20'; printf '%s=' "$key" | openssl base64 -d -A; } |
        openssl pkey -inform DER -pubout -outform DER 2>/dev/null | tail -c 32 | openssl base64 -A | tr '+/' '-_' | tr -d '=') || return 1
    [[ $out =~ ^[A-Za-z0-9_-]{43}$ ]] && printf '%s\n' "$out"
}

# Reality and ShadowTLS borrow the TLS 1.3 handshake of the same vetted sites.
# Without --sni the target is picked at create time (handshake_target_ready).
handshake_target_prompt() {
    sni=''
    [[ -n ${opt_sni:-} ]] || return 0
    reality_target_allowed "$opt_sni" || return 1
    sni=$opt_sni
}
# At create, with dependencies installed: checks the chosen target, or takes the
# first built-in one that passes the check, so users never have to find one.
handshake_target_ready() {
    local target
    if [[ -n $sni ]]; then reality_target_check "$sni"; return; fi
    for target in $REALITY_TARGETS; do
        if reality_target_check "$target" 2>/dev/null; then sni=$target; return 0; fi
    done
    err '内置的握手目标都没有通过检查，请检查本机 DNS / 网络 / 系统时间后重试。'; return 1
}
handshake_retarget() {
    local node=$1 target=$2
    reality_target_allowed "$target" || return 1
    if [[ $(printf '%s' "$node" | jq -r .sni) == "$target" ]]; then
        msg '当前已经使用此目标，无需修改。'; REPLY=''; return 0
    fi
    reality_target_check "$target" || return 1
    REPLY=$(jq -nc --arg sni "$target" '{sni:$sni}')
}
reality_target_allowed() {
    [[ " $REALITY_TARGETS " == *" $1 "* ]] || { err "握手目标只能选择：$REALITY_TARGETS"; return 1; }
}
reality_target_select() {
    msg $'握手目标（无需拥有该域名或申请证书）：\n1. 携程：www.ctrip.com\n2. 西瓜视频：www.ixigua.com'
    ask '选择目标（0 返回）' 1 || return 1
    case $REPLY in
      1) REPLY=www.ctrip.com;;
      2) REPLY=www.ixigua.com;;
      *) err '请选择 1 或 2。'; return 1;;
    esac
}
reality_target_check() {
    local domain=$1 output rc=0
    valid_domain "$domain" || return 1
    output=$(mktemp) || return 1
    msg "检查握手目标 ${domain} 的 TLS 1.3、证书和 HTTP/2…"
    timeout 15 openssl s_client -connect "$domain:443" -servername "$domain" \
        -tls1_3 -alpn h2 -verify_hostname "$domain" -verify_return_error \
        </dev/null > "$output" 2>&1 || rc=$?
    if [[ $rc != 0 ]] || ! grep -q 'TLSv1.3' "$output" ||
       ! grep -q 'ALPN protocol: h2$' "$output" || ! grep -q 'Verify return code: 0 (ok)' "$output"; then
        rm -f "$output"
        err '目标检测失败，请重新部署并选择另一个目标，或检查本机 DNS / 网络 / 系统时间。'
        return 1
    fi
    rm -f "$output"
}

# --- Shared TLS certificate handling ------------------------------------------
# Option variables (mode email webroot cert key) are locals of node_add.
# A protocol whose clients can pin a certificate passes "selfsigned": it then also
# offers a self-signed certificate, the default when the server has no domain.
SELF_SIGNED_SNI=www.bing.com
# No questions: node_add has asked for the domain already. The method comes from
# --cert, else a self-signed certificate when allowed and there is no domain, else
# Let's Encrypt with automatic validation (node_add offers the other methods in
# the menu when 80 and 443 are both taken).
tls_prompt() {
    local allow=${1:-} default=auto domain=''
    # valid_domain also accepts dotted IPv4 addresses, which cannot get a certificate.
    if [[ ! $host =~ ^[0-9.]+$ ]] && valid_domain "$host"; then domain=$host; fi
    [[ $allow != selfsigned || -n $domain || -n ${opt_sni:-} ]] || default=selfsigned
    case ${opt_cert:-$default} in
      auto) mode=auto;;
      webroot) mode=webroot;;
      import) mode=import;;
      selfsigned)
        [[ $allow == selfsigned ]] || { err '此协议需要域名证书，不支持自签证书。'; return 1; }
        mode=selfsigned; sni=${opt_sni:-$SELF_SIGNED_SNI}; return 0;;
      *) err '证书方式只能是 auto、webroot、import 或 selfsigned。'; return 1;;
    esac
    sni=${opt_sni:-$domain}
    [[ -n $sni ]] || { err '非交互模式缺少参数：证书域名（--domain）'; return 1; }
    case $mode in
      webroot) ask_opt "${opt_webroot:-}" '现有网站根目录绝对路径' || return 1; webroot=$REPLY;;
      import)
        ask_opt "${opt_cert_file:-}" '完整证书链绝对路径' || return 1; cert=$REPLY
        ask_opt "${opt_key_file:-}" '私钥绝对路径' || return 1; key=$REPLY;;
    esac
    email=${opt_email:-}
    [[ -z $email || $email == *@*.* ]] || { err '邮箱格式不正确。'; return 1; }
}
# REPLY = certificate fields of the node: cert_dir, plus the pins of a self-signed one.
tls_create() {
    local tmp cert_rc
    case $mode in
      selfsigned) selfsigned_create; return;;
      import)
        cert_valid "$cert" "$key" "$sni" || { err '证书与域名/私钥不匹配，或一天内到期。'; return 1; }
        tmp=$(mktemp -d) || return 1
        cp "$cert" "$tmp/fullchain.pem" && cp "$key" "$tmp/key.pem" && activate_cert "$sni" "$tmp"
        cert_rc=$?; rm -rf "$tmp"; [[ $cert_rc == 0 ]] || return 1
        msg '导入的外部证书需由原签发工具续期，再导入新证书。';;
      *) issue_certificate "$sni" "$mode" "$email" "$webroot" || return 1;;
    esac
    REPLY=$(jq -nc --arg cert "$DATA/certs/$sni/active" '{cert_dir:$cert}')
}
# One self-signed certificate per node ($id is node_add's new node ID), valid for
# ten years and never renewed; clients pin its hashes.
selfsigned_create() {
    local dir=$DATA/selfsigned/$id cert_hash key_hash
    install -d -m 750 "$DATA/selfsigned" "$dir" && chgrp srm "$DATA/selfsigned" "$dir" || return 1
    if ! openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -days 3650 -subj "/CN=$sni" \
         -addext "subjectAltName=DNS:$sni" -keyout "$dir/key.pem" -out "$dir/fullchain.pem" >/dev/null 2>&1; then
        err '自签证书生成失败。'; return 1
    fi
    chmod 640 "$dir/key.pem" "$dir/fullchain.pem" && chgrp srm "$dir/key.pem" "$dir/fullchain.pem" || return 1
    # Certificate hash (Surge, mihomo, Hysteria2 links) and public key hash (sing-box).
    cert_hash=$(openssl x509 -in "$dir/fullchain.pem" -outform der | openssl dgst -sha256 | awk '{print $NF}') &&
        key_hash=$(openssl x509 -in "$dir/fullchain.pem" -pubkey -noout | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | openssl base64 -A) || return 1
    REPLY=$(jq -nc --arg dir "$dir" --arg cert "$cert_hash" --arg key "$key_hash" '{cert_dir:$dir,cert_sha256:$cert,pubkey_sha256:$key}')
}
tls_validate() {
    printf '%s' '(.sni|text) and (.cert_dir|text and startswith("/")) and
      ((pinned|not) or ((.cert_sha256|test("^[a-f0-9]{64}$")) and (.pubkey_sha256|test("^[A-Za-z0-9+/]{43}=$"))))'
}
# Merges new credentials into REPLY (from tls_create) or into an empty object.
with_password() {
    local value
    value=$(random_hex 24) || return 1
    REPLY=$(jq -c --arg v "$value" '. + {password:$v}' <<< "${REPLY:-null}")
}
with_uuid() {
    local value
    value=$("$CORE" generate uuid) || return 1
    REPLY=$(jq -c --arg v "$value" '. + {uuid:$v}' <<< "${REPLY:-null}")
}
UUID_VALID='(.uuid|test("^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"))'
# v3_import of a TLS protocol without a transport: an INBOUND of sing-box TYPE with a
# certificate; FIELDS (jq) are taken from it along with the SNI.
v3_tls_import() {
    local in=$1 type=$2 fields=$3
    jq -e --arg t "$type" '.type == $t and .tls.enabled == true and .tls.reality.enabled != true' <<< "$in" >/dev/null || return 1
    jq -e '.transport == null' <<< "$in" >/dev/null || { REPLY="v4 不支持这种节点带 $(jq -r .transport.type <<< "$in") 传输"; return 2; }
    REPLY=$(jq -c "{sni:.tls.server_name} + ($fields)" <<< "$in")
}

