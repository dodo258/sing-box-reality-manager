    elif [[ $mode == http ]]; then
        [[ -z $(ss -H -ltn 'sport = :80') ]] || { err '80 端口已占用，请使用现有网站目录验证，不会停止已有服务。'; exit 1; }
    elif [[ $mode == webroot ]]; then
