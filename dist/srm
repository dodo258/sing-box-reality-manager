    if [[ ! -f $STATE ]] || { "$CORE" check -c "$DATA/current/config.json" && { [[ $active == 0 ]] || { restart_unit "$SERVICE" && service_healthy "$STATE"; }; }; }; then return 0; fi
    if [[ -n $old ]]; then
        ln -s "$old" "$dir/.next" && mv -Tf "$dir/.next" "$dir/active"
        [[ $active == 0 ]] || restart_unit "$SERVICE"
