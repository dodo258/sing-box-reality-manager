        local challenge=--standalone
        [[ $mode != alpn ]] || challenge=--alpn
        acme_call "$domain" --issue "$challenge" -d "$domain" --keylength ec-256 --server letsencrypt --accountemail "$email" > "$SRM_ROOT/acme-accounts/$domain/issue.log" 2>&1 || rc=$?
    else
        acme_call "$domain" --issue --webroot "$webroot" -d "$domain" --keylength ec-256 --server letsencrypt --accountemail "$email" > "$SRM_ROOT/acme-accounts/$domain/issue.log" 2>&1 || rc=$?
    fi
    if [[ $rc != 0 && $rc != 2 ]]; then err "证书申请失败。日志：$SRM_ROOT/acme-accounts/$domain/issue.log（分享前请检查敏感信息）。"; exit 1; fi
    copy_acme_cert "$domain" && install_renew_timer
)
# Automatic validation listens on 80 (http) or 443 (alpn). A port is not free if
# anything listens on it, a TCP node owns it (even a stopped one), or it is
# cert_avoid_port, set by node_add for the TCP node being deployed.
cert_auto_mode() {
    local taken=" ${cert_avoid_port:-} "
    if [[ -f $STATE ]]; then
        taken+=$(jq -r "[.nodes[]|select(any(($(proto_jq_transports))[]; . == \"tcp\"))|.port|tostring]|join(\" \")" "$STATE") || return 1
        taken+=' '
    fi
    if [[ $taken != *' 80 '* && -z $(ss -H -ltn 'sport = :80') ]]; then printf 'http\n'
    elif [[ $taken != *' 443 '* && -z $(ss -H -ltn 'sport = :443') ]]; then printf 'alpn\n'
    else return 1; fi
}
# TCP port that renewing DOMAIN needs: the recorded one, else what acme.sh saved.
cert_challenge_port() {
    local domain=$1 port=80 account=$SRM_ROOT/acme-accounts/$1
    if [[ -f $account/challenge-port ]]; then
        read -r port < "$account/challenge-port" || return 1
    elif grep -q "^Le_Webroot='alpn'" "$account/${domain}_ecc/$domain.conf" 2>/dev/null; then port=443; fi
    printf '%s\n' "$port"
}
# A TCP node must not take the port a renewed certificate validates on, or every
# renewal fails until the certificate expires. Checks the certificates of current
# nodes plus an optional DOMAIN about to be used.
cert_port_ok() {
    local port=$1 transport=$2 domain
    [[ " $transport " == *" tcp "* ]] || return 0
    while IFS= read -r domain; do
        [[ -n $domain && $(certificate_source "$domain") == acme ]] || continue
        if [[ $(cert_challenge_port "$domain") == "$port" ]]; then
            err "TCP $port 要留给证书 $domain 自动续期验证，节点不能占用；请换一个端口。"; return 1
        fi
    done < <({ [[ ! -f $STATE ]] || jq -r ".nodes[]|select($CERT_NODES)|.sni" "$STATE"; printf '%s\n' "${3:-}"; } | sort -u)
}
install_renew_timer() {
    cat > /etc/systemd/system/srm-renew.service <<UNIT
[Unit]
Description=srm certificate renewal
[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/local/sbin/srm renew
UNIT
    cat > /etc/systemd/system/srm-renew.timer <<'UNIT'
[Unit]
Description=srm daily certificate check
[Timer]
OnCalendar=daily
RandomizedDelaySec=3600
Persistent=true
[Install]
WantedBy=timers.target
UNIT
    systemctl daemon-reload && systemctl enable --now srm-renew.timer
}
renew_certificates() {
    owned_root || return 1
    [[ -f $STATE ]] || return 0
    local domain rc failures=0
    while IFS= read -r domain; do
        if [[ $(certificate_source "$domain") == v3 ]]; then
            openssl x509 -in "$DATA/certs/$domain/active/fullchain.pem" -noout -checkend 2592000 >/dev/null 2>&1 && continue
            msg "从旧版迁移来的证书 $domain 30 天内到期，向 Let's Encrypt 申请新证书。"
            issue_certificate "$domain" auto '' '' force || { err "证书申请失败：${domain}；保留当前证书，明天再试。"; failures=$((failures+1)); }
            continue
        fi
        [[ $(certificate_source "$domain") == acme ]] || continue
        # Record a verified legacy association before acme.sh replaces its export.
        # Otherwise a failed activation makes the still-active old cert look imported.
        if ! certificate_preserve_source "$domain"; then failures=$((failures+1)); continue; fi
        rc=0
        firewall_renew "$domain" > "$SRM_ROOT/acme-accounts/$domain/renew.log" 2>&1 || rc=$?
        if [[ $rc == 0 || $rc == 2 ]]; then
            if ! copy_acme_cert "$domain"; then
                err "新证书未能应用：${domain}；保留当前证书，下次续期检查会重试应用。"
                failures=$((failures+1))
            fi
        else err "证书续期失败：${domain}；保留原证书。日志：$SRM_ROOT/acme-accounts/$domain/renew.log"; failures=$((failures+1)); fi
    done < <(jq -r ".nodes[]|select($CERT_NODES)|.sni" "$STATE" | sort -u)
    [[ $failures == 0 ]]
}
certificate_preserve_source() {
    local domain=$1 active=$DATA/certs/$1/active tmp
    [[ ! -f $active/renewal-source ]] || return 0
    [[ $(certificate_source "$domain") == acme ]] || return 1
    tmp=$(mktemp "$active/.renewal-source.XXXXXXXX") || return 1
    if printf 'acme\n' > "$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$active/renewal-source"; then return 0; fi
    rm -f "$tmp"; return 1
}
certificate_source() {
    local domain=$1 active=$DATA/certs/$1/active account=$SRM_ROOT/acme-accounts/$1 value
    if [[ -f $active/renewal-source ]]; then
        value=$(cat "$active/renewal-source") || return 1
        case $value in acme|import|v3) printf '%s\n' "$value";; *) printf 'unknown\n';; esac
    elif [[ -f $account/${domain}_ecc/$domain.conf && -f $account/export/fullchain.pem ]] &&
         cmp -s "$account/export/fullchain.pem" "$active/fullchain.pem"; then
        # Legacy releases had no origin marker. An account directory alone is not proof.
        printf 'acme\n'
    else printf 'import\n'; fi
}
certificate_status() {
    local domain cert count source health expiry issuer enabled running
    msg $'\n证书管理（只显示本脚本节点使用的证书）\nReality 无需自行申请证书；使用 TLS 证书的节点在这里查看到期时间和续期状态。'
    if [[ -f $STATE ]]; then
        count=$(jq '[.nodes[]|select(.cert_sha256 != null)]|length' "$STATE") || return 1
        [[ $count == 0 ]] || msg "另有 $count 个节点使用自签证书：有效期十年，客户端按证书指纹校验，不需要续期。"
    fi
    if [[ ! -f $STATE ]] || ! jq -e "any(.nodes[]; $CERT_NODES)" "$STATE" >/dev/null; then
        msg '目前没有使用 TLS 证书的节点。'; return 0
    fi
    enabled=$(systemctl is-enabled srm-renew.timer 2>/dev/null) || enabled='未启用'
    running=$(systemctl is-active srm-renew.timer 2>/dev/null) || running='未运行'
    printf '自动续期定时任务：%s / %s（每日检查，仅管理本脚本签发的证书）\n' "$enabled" "$running"
    systemctl list-timers --all srm-renew.timer --no-pager 2>/dev/null || true
    while IFS= read -r domain; do
        cert=$DATA/certs/$domain/active/fullchain.pem
        count=$(jq --arg d "$domain" "[.nodes[]|select($CERT_NODES and .sni==\$d)]|length" "$STATE") || return 1
        source=$(certificate_source "$domain") || return 1
        case $source in
          acme) source="Let's Encrypt 自动续期";;
          import) source='外部导入：由原工具续期后重新导入';;
          v3)
            if cert_auto_mode >/dev/null; then source="从旧版迁移：到期前 30 天自动向 Let's Encrypt 重新申请"
            else source='从旧版迁移：80 和 443 端口都被占用，没法自动重新申请；到期前请空出 80 端口，再选「2. 立即检查续期」'; fi;;
          *) source='来源标记异常：暂不自动续期';;
        esac
        printf '\n域名：%s（%s 个节点共用）\n来源：%s\n' "$domain" "$count" "$source"
        if ! expiry=$(openssl x509 -in "$cert" -noout -enddate 2>/dev/null); then
            msg '状态：证书缺失或无法读取'; continue
        fi
        issuer=$(openssl x509 -in "$cert" -noout -issuer 2>/dev/null) || issuer='issuer=未知'
        if ! openssl x509 -in "$cert" -noout -checkend 0 >/dev/null 2>&1; then health='已到期'
        elif ! openssl x509 -in "$cert" -noout -checkend 2592000 >/dev/null 2>&1; then health='30 天内到期'
        else health='有效'; fi
        printf '到期时间：%s\n签发者：%s\n状态：%s\n' "${expiry#notAfter=}" "${issuer#issuer=}" "$health"
    done < <(jq -r ".nodes[]|select($CERT_NODES)|.sni" "$STATE" | sort -u)
}
certificate_renew_now() {
    msg '检查本脚本签发的证书：达到续期条件时才申请，未到期不会强制重签。'
    renew_certificates || return 1
    msg '检查完成；外部导入证书不参与自动续期。'
    certificate_status
}
certificate_menu() {
    while :; do
        certificate_status || return 1
        [[ -f $STATE ]] || return 0
        msg $'\n1. 刷新证书状态\n2. 立即检查续期（成功更换证书后可能短暂重启本脚本节点）\n0. 返回'
        ask '操作' || return 0
        case $REPLY in
          1) ;;
          2) with_lock certificate_renew_now || return 1;;
          *) err '无效选项。';;
        esac
    done
}
# Conservative built-in domain groups; exact additions remain visible/editable.
platform_domains() {
    case $1 in
      netflix) printf '%s\n' 'netflix.com nflxvideo.net nflximg.net nflximg.com nflxso.net nflxext.com';;
      disney) printf '%s\n' 'disneyplus.com disney-plus.net dssott.com bamgrid.com';;
      youtube) printf '%s\n' 'youtube.com youtubei.googleapis.com googlevideo.com ytimg.com youtu.be';;
      *) return 1;;
    esac
}
routing_conflicts() {
    # Compare opposite modes only; same-mode rules share the same resolver/outbound.
    # A suffix includes itself and its subdomains, but not lookalike hostnames.
    # Rules limited to disjoint sets of nodes never meet the same connection.
    jq -r --arg name "${2:-}" '
      def shared($a; $b): $a.inbounds == null or $b.inbounds == null or any($a.inbounds[]; . as $i | any($b.inbounds[]; . == $i));
      .policies as $p |
      range(0; $p|length) as $i | range($i+1; $p|length) as $j |
      $p[$i] as $a | $p[$j] as $b |
      select($a.mode != $b.mode and shared($a; $b) and ($name == "" or $a.name == $name or $b.name == $name)) |
      $a.domains[] as $x | $b.domains[] as $y |
      select($x == $y or ($x|endswith("."+$y)) or ($y|endswith("."+$x))) |
      "\($a.name) [\($a.mode)] \($x) ↔ \($b.name) [\($b.mode)] \($y)"
    ' "$1"
}
routing_check_conflicts() {
    local conflicts
    conflicts=$(routing_conflicts "$1" "${2:-}") || return 1
    [[ -n $conflicts ]] || return 0
    err 'DNS 解锁与代理出口的域名范围重叠，请先修改或删除冲突规则：'
    printf '%s\n' "$conflicts" >&2
    return 1
}
routing_show() {
    [[ -f $STATE ]] || { err '请先部署节点。'; return 1; }
    jq '(.nodes|map({key:.id,value:.name})|from_entries) as $names |
      {unlock_dns,egress:(if .egress then (.egress|del(.password)) else null end),
       policies:[.policies[]|. + {nodes:(if .inbounds then [.inbounds[]|$names[.]] else "全部节点" end)}]}' "$STATE" || return 1
    if ! routing_check_conflicts "$STATE"; then msg '已有规则保持原状，重叠部分按当前配置由代理规则优先处理。'; fi
    routing_bypass_note
}
# Nodes served by a helper program connect out on their own, past sing-box's rules.
routing_bypass_note() {
    local names
    names=$(jq -r "$PROTO_JQ_DEFS [.nodes[]|select(($(proto_jq sidecar empty))|length > 0)|.name]|join(\"、\")" "$STATE") || return 1
    [[ -z $names ]] || msg "注意：节点 ${names} 的流量由独立服务直接发出，不经过分流规则。"
}
routing_menu() {
    [[ -f $STATE ]] || { err '请先部署节点。'; return 1; }
    msg '解锁 DNS 需要客户端把域名或 DNS 查询交给本服务器；仅发送已解析 IP 时，SNI 嗅探不会自动重写该 IP。指定代理出口可按可识别的域名分流。'
    routing_bypass_note
    msg '流媒体分流：1.查看 2.设置解锁 DNS 3.设置代理出口（SOCKS5） 4.添加/替换平台规则 5.删除平台规则'
    ask '操作' 1 || return 0
    local host port user name mode domains scope
    case $REPLY in
      1) routing_show;;
      2) ask '解锁 DNS 的 IP 地址' || return 0; routing_change dns "$REPLY";;
      3)
        msg '只把命中平台的流量送到此 SOCKS5 出口。出口需支持 UDP 才能承载 QUIC；不会自动回落本机。'
        ask '出口 IP/域名' || return 0; host=$REPLY
        ask '出口端口' 1080 || return 0; port=$REPLY
        ask '用户名（无认证则留空）' || return 0; user=$REPLY
        routing_change egress "$host" "$port" "$user";;
      4)
        ask '平台：netflix / disney / youtube / 自定义名称' netflix || return 0; name=$REPLY
        domains=$(platform_domains "$name") || domains=''
        ask '匹配域名后缀，空格分隔（会显示完整范围）' "$domains" || return 0; domains=$REPLY
        ask '方式：dns 或 proxy' dns || return 0; mode=$REPLY
        routing_scope_select "$name" || return 0; scope=$REPLY
        routing_change add "$name" "$mode" "$domains" ${scope:+--nodes "$scope"};;
      5) ask '要删除的规则名称' || return 0; routing_change del "$REPLY";;
      *) err '无效选项。'; return 1;;
    esac
}
# Picks the nodes rule NAME applies to by menu number. REPLY = comma-separated
# node IDs, "all" for every node, or empty to keep an existing rule's scope
# (every node for a new rule). Replacing a rule offers its current nodes first.
routing_scope_select() {
    local count index=0 name type port picks pick ids='' current default=全部
    count=$(jq '.nodes|length' "$STATE") || return 1
    REPLY=''
    (( count > 1 )) || return 0
    current=$(jq -r --arg name "$1" '. as $s | .policies[]|select(.name==$name and .inbounds)|
      [.inbounds[] as $i | $s.nodes|map(.id)|index($i)+1|tostring]|join(" ")' "$STATE") || return 1
    [[ -z $current ]] || default=$current
    msg '作用范围（可以只让部分节点走这条规则）：'
    while IFS=$'\t' read -r name type port; do
        index=$((index+1))
        printf '  %s. %s | %s | 端口 %s\n' "$index" "$name" "$type" "$port"
    done < <(jq -r '.nodes[]|[.name,.type,(.port|tostring)]|@tsv' "$STATE")
    ask "节点序号，多个用空格分隔（输入「全部」= 所有节点）" "$default" || return 1
    [[ $REPLY != 全部 ]] || { REPLY=all; return 0; }
    [[ $REPLY =~ ^[0-9\ ]+$ ]] || { err "请输入 1–$count 的序号。"; return 1; }
    picks=$REPLY
    for pick in $picks; do
        [[ $pick =~ ^[1-9][0-9]{0,5}$ ]] && (( pick <= count )) || { err "请输入 1–$count 的序号。"; return 1; }
        ids+=${ids:+,}$(jq -r --argjson i "$((pick-1))" '.nodes[$i].id' "$STATE") || return 1
    done
    [[ -n $ids ]] || { err "请输入 1–$count 的序号。"; return 1; }
    REPLY=$ids
}
# Comma-separated node IDs → JSON array; every ID must name an existing node.
routing_node_ids() {
    local list
    list=$(jq -c --arg ids "$2" '[$ids|split(",")[]|select(length>0)]|unique' <<< null) || return 1
    jq -e --argjson ids "$list" '. as $s | ($ids|length) > 0 and all($ids[]; . as $i | any($s.nodes[]; .id == $i))' "$1" >/dev/null ||
        { err "节点 ID 不存在：$2（在节点管理里查看 ID）"; return 1; }
    printf '%s\n' "$list"
}
# Non-interactive routing changes, shared with the menu:
#   dns IP | egress HOST PORT [USER] (password read from stdin) | del NAME
#   add NAME dns|proxy DOMAIN… [--nodes ID,ID…|all]
#     --nodes limits the rule to those nodes, "all" makes it apply to every node;
#     without it a replaced rule keeps its nodes and a new rule applies to every node.
# Domain arguments may also hold several space-separated suffixes.
routing_change() {
    local op=${1:-} candidate tmp host port user pass='' name mode domains nodes='' rc=1 max=0 arg suffixes=()
    [[ -f $STATE ]] || { err '请先部署节点。'; return 1; }
    shift
    case $op in dns|del) max=1;; egress) max=3;; esac
    (( max == 0 || $# <= max )) || { err "多余的参数：${*:max+1}"; return 1; }
    candidate=$(new_candidate) || return 1
    tmp=$(mktemp) || { rm -f "$candidate"; return 1; }
    case $op in
      dns)
        host=${1:-}
        if [[ $host =~ ^[0-9.]+$ || $host =~ ^[0-9a-fA-F:]+$ ]] && valid_ip "$host"; then
            jq --arg host "$host" '.unlock_dns=$host' "$candidate" > "$tmp" && rc=0
        else err '解锁 DNS 请输入 IP。'; fi;;
      egress)
        host=${1:-} port=${2:-1080} user=${3:-}
        if ! valid_host "$host"; then err '出口地址无效。'
        elif ! [[ $port =~ ^[1-9][0-9]{0,4}$ ]] || ((port > 65535)); then err '出口端口无效。'
        elif [[ -n $user ]] && ! read_secret '密码（不回显）'; then err '没有从标准输入读到密码，未修改。'
        else
            [[ -z $user ]] || pass=$REPLY
            jq --arg host "$host" --argjson port "$port" --arg user "$user" --arg pass "$pass" '.egress={type:"socks",version:"5",server:$host,server_port:$port} + (if $user!="" then {username:$user,password:$pass} else {} end)' "$candidate" > "$tmp" && rc=0
        fi;;
      add)
        name=${1:-} mode=${2:-}
        shift 2 2>/dev/null || shift $#
        while (( $# )); do
            arg=$1; shift
            if [[ $arg == --nodes ]]; then nodes=${1:-,}; shift $(( $# ? 1 : 0 ))
            else suffixes+=("$arg"); fi
        done
        if [[ -z $name ]] || (( ${#suffixes[@]} == 0 )); then err '用法：srm routing add 名称 dns|proxy 域名后缀… [--nodes 节点ID,…|all]'
        elif [[ $mode != dns && $mode != proxy ]]; then err '方式只能是 dns 或 proxy。'
        elif [[ -n $nodes && $nodes != all ]] && ! nodes=$(routing_node_ids "$candidate" "$nodes"); then :
        else
            [[ -n $nodes ]] || nodes=$(jq -c --arg name "$name" 'first(.policies[]|select(.name==$name)|.inbounds) // null' "$candidate") || nodes=null
            [[ $nodes != all ]] || nodes=null
            domains=$(printf '%s\n' "${suffixes[@]}" | jq -Rsc 'split("\n")|map(split(" ")[])|map(select(length>0)|ascii_downcase)|unique') &&
            jq --arg name "$name" --arg mode "$mode" --argjson domains "$domains" --argjson nodes "$nodes" '
              .policies=(.policies|map(select(.name!=$name)))+[{name:$name,mode:$mode,domains:$domains} + (if $nodes then {inbounds:$nodes} else {} end)]' "$candidate" > "$tmp" &&
            routing_check_conflicts "$tmp" "$name" && rc=0
        fi;;
      del)
        name=${1:-}
        if jq -e --arg name "$name" 'any(.policies[]; .name==$name)' "$candidate" >/dev/null; then
            jq --arg name "$name" '.policies|=map(select(.name!=$name))' "$candidate" > "$tmp" && rc=0
        else err "没有名为 ${name:-空} 的规则。"; fi;;
      *) err '用法：srm routing [show|dns|egress|add|del]';;
    esac
    if [[ $rc == 0 ]]; then
        rc=1
        if mv "$tmp" "$candidate" && apply_state "$candidate"; then rc=0; fi
    fi
    rm -f "$candidate" "$tmp"
    return "$rc"
}
# All mutation menu paths execute under with_lock.
# node_add SELF [TYPE] [--name N] [--host H] [--port P|random] [--domain D] [--sni D]
#          [--cert auto|webroot|import|selfsigned] [--webroot DIR] [--cert-file F] [--key-file F]
#          [--email E] [--transport tcp|ws|grpc|httpupgrade] [--proto-version V] [--proto-mode M]
#          [--bbr enable|keep] [--yes] [--json]
# Interactive (the menu, `srm add` without --yes): without TYPE the quick-deploy list
# opens. Only the domain is typed (protocols that need a certificate); besides it at
# most two questions with defaults: the protocol's own one, port, name. The server
# address, handshake target and certificate method are chosen automatically.
# --json prints one JSON object on stdout and everything else on stderr. Outside the
# menu, leaving without a new node is a failure (exit code non-zero, no JSON).
node_add() {
    local self=$1 arg json=0 rc=0
    shift
    for arg in "$@"; do [[ $arg != --json ]] || json=1; done
    DEPLOYED_NODE=''
    if [[ $json == 0 ]]; then node_add_main "$self" "$@" || rc=$?
    else node_add_main "$self" "$@" >&2 || rc=$?; fi
    [[ $rc == 0 ]] || return "$rc"
    if [[ -z $DEPLOYED_NODE ]]; then
        [[ -n ${IN_MENU:-} ]] || { err '没有部署节点。'; return 1; }
        return 0
    fi
    [[ $json == 0 ]] || deploy_json <<< "$DEPLOYED_NODE"
}
node_add_main() {
    local self=$1 type='' var assume_yes=0 rc
    local opt_name='' opt_host='' opt_port='' opt_domain='' opt_sni='' opt_cert='' opt_webroot='' opt_cert_file='' opt_key_file='' opt_email='' opt_bbr='' opt_transport=''
    local opt_proto_version='' opt_proto_mode=''
    shift
    if [[ -n ${1:-} && $1 != -* ]]; then type=$1; shift; fi
    while (( $# )); do
        case $1 in
          -y|--yes) assume_yes=1; shift; continue;;
          --json) shift; continue;;
          --name|--host|--port|--domain|--sni|--cert|--webroot|--cert-file|--key-file|--email|--transport|--proto-version|--proto-mode|--bbr) ;;
          *) err "未知参数：$1（可用参数见 srm --help）"; return 1;;
        esac
        [[ $# -ge 2 && -n $2 ]] || { err "$1 需要一个值。"; return 1; }
        var=${1#--}; var=opt_${var//-/_}
        printf -v "$var" '%s' "$2"
        shift 2
    done
    if [[ -n $type ]]; then
        proto_known "$type" || { err "不支持的协议：$type（可选：$PROTOCOLS）"; return 1; }
    elif [[ $assume_yes == 1 ]]; then err "非交互模式需要指定协议：$PROTOCOLS"; return 1; fi
    # 3 from node_deploy: the user went back or has no domain; the list comes (back).
    while :; do
        if [[ -z $type ]]; then quick_pick || return 0; type=$REPLY; fi
        rc=0; node_deploy "$type" || rc=$?
        [[ $rc == 3 ]] || return "$rc"
        # Options that belonged to the previous protocol do not follow to the next one.
        type='' opt_domain='' opt_sni='' opt_cert='' opt_webroot='' opt_cert_file='' opt_key_file=''
        opt_transport='' opt_proto_version='' opt_proto_mode=''
    done
}
# The quick-deploy list; REPLY = protocol type, failure = back.
quick_pick() {
    local type i more label
    while :; do
        msg $'\n快速部署（任一步输入 0 返回；同一协议可以部署多个节点）'
        i=0
        for type in $QUICK_PROTOCOLS; do
            i=$((i+1)); label=$(proto_call "$type" label)
            printf '  %s. %-18s %s\n' "$i" "${label%%（*}" "$(proto_quick_hint "$type")"
        done
        more=''
        for type in $(quick_more); do label=$(proto_call "$type" label); more+="${more:+、}${label%%（*}"; done
        printf '  %s. 更多协议…          %s\n' "$((i+1))" "$more"
        ask '请选择' 1 || return 1
        # shellcheck disable=SC2086 # one type per word
        if type=$(nth_word "$REPLY" $QUICK_PROTOCOLS); then REPLY=$type; return 0; fi
        if [[ $REPLY != "$((i+1))" ]]; then err "请选择 1–$((i+1))。"; continue; fi
        quick_pick_more && return 0
    done
}
nth_word() {
    local n=$1
    shift
    [[ $n =~ ^[1-9][0-9]*$ ]] && (( n <= $# )) || return 1
    printf '%s\n' "${!n}"
}
# Protocols outside the first page, those without a domain first.
quick_more() {
    local need type
    for need in none optional required; do
        for type in $PROTOCOLS; do
            [[ " $QUICK_PROTOCOLS " != *" $type "* && $(proto_call "$type" domain) == "$need" ]] && printf '%s\n' "$type"
        done
    done
    return 0
}
proto_quick_hint() {
    if proto_has "$1" hint; then proto_call "$1" hint
    elif [[ $(proto_call "$1" domain) == required ]]; then printf '需要域名'
    else printf '不需要域名'; fi
}
quick_pick_more() {
    local types type i=0 label
    types=$(quick_more)
    msg $'\n更多协议：'
    for type in $types; do
        i=$((i+1)); label=$(proto_call "$type" label)
        printf '  %s. %-18s %s\n' "$i" "${label%%（*}" "$(proto_quick_hint "$type")"
    done
    while :; do
        ask '请选择' 1 || return 1
        # shellcheck disable=SC2086 # one type per word
        if type=$(nth_word "$REPLY" $types); then REPLY=$type; return 0; fi
        err "请选择 1–$i。"
    done
}
# Interactive: the certificate domain, asked (ASK=1) and checked until it resolves to
# this server. Returns 3 for "no domain, pick another protocol" or back, 0 when the
# domain is set in opt_sni (also when the user goes on despite a CDN in front).
cert_domain_confirm() {
    local ask_first=$1
    while :; do
        if [[ $ask_first == 1 ]]; then
            msg "$(proto_call "$type" label) 需要一个已经解析到本机（$host）的域名，用来申请免费证书。"
            ask '域名（没有域名直接回车，换一个协议）' || return 3
            [[ -n $REPLY ]] || return 3
            REPLY=$(tr '[:upper:]' '[:lower:]' <<< "$REPLY")
            if [[ $REPLY =~ ^[0-9.]+$ ]] || ! valid_domain "$REPLY"; then err '域名格式不对，例如 vpn.example.com（中文域名请用 Punycode）。'; continue; fi
            opt_sni=$REPLY
        fi
        # Imported certificates and website-directory validation do not need it.
        [[ -z $opt_cert || $opt_cert == auto ]] || return 0
        cert_reusable "$opt_sni" && return 0
        domain_resolves_here "$opt_sni" "$host" && return 0
        msg $'  1. 重新检查（刚改好解析的话，等一两分钟再选）\n  2. 换一个域名\n  3. 没有域名，换一个协议\n  4. 仍然申请证书（域名开了 CDN 代理时选）\n  0. 返回'
        while :; do
            ask '请选择' 1 || return 3
            case $REPLY in 1) ask_first=0;; 2) ask_first=1;; 3) return 3;; 4) return 0;; *) err '请选择 0–4。'; continue;; esac
            break
        done
    done
}
# One deployment of TYPE with node_add_main's options. Returns 3 to go back to the
# protocol list.
node_deploy() {
    local type=$1 name host port sni='' bbr=keep candidate node id tmp transport cert_avoid_port='' need questions=0 checked='' saved
    # Protocol prompt hooks fill these.
    local mode=none email='' webroot='' cert='' key='' stream='' proto_version='' proto_mode=''
    # Answers given in this round only; going back to the list forgets them.
    local opt_sni=$opt_sni opt_cert=$opt_cert opt_webroot=$opt_webroot opt_cert_file=$opt_cert_file opt_key_file=$opt_key_file
    local opt_transport=$opt_transport opt_proto_version=$opt_proto_version opt_proto_mode=$opt_proto_mode
    need=$(proto_call "$type" domain) || return 1
    if [[ -n $opt_domain ]]; then
        [[ $need != none ]] || { err "$(proto_call "$type" label) 不需要域名，请去掉 --domain。"; return 1; }
        [[ -z $opt_sni || $opt_sni == "$opt_domain" ]] || { err '--domain 和 --sni 不一致。'; return 1; }
        opt_sni=$opt_domain
    fi
    if [[ -n $opt_host ]]; then host=$opt_host
    else
        msg '检测本机公网 IP…'
        if detect_public_ip; then host=$PUBLIC_IP; msg "本机公网 IP：$host"
        elif [[ $assume_yes == 1 ]]; then err '没有检测到本机公网 IP，非交互模式缺少参数：--host'; return 1
        else
            while :; do
                ask '没有检测到本机公网 IP，请填写客户端连接用的 IP 或域名' || return 3
                host=$REPLY
                valid_host "$host" && break
                err '地址不合法，例如 203.0.113.5 或 vpn.example.com。'
            done
        fi
    fi
    valid_host "$host" || { err '地址不合法。'; return 1; }
    # The domain comes first: without one the user picks another protocol right away.
    # Optional-domain protocols need one only when a domain certificate was asked for.
    if [[ $need == required || ( $need == optional && -n $opt_cert && $opt_cert != selfsigned ) ]] &&
       [[ -z $opt_sni ]] && ! { [[ ! $host =~ ^[0-9.]+$ ]] && valid_domain "$host"; }; then
        [[ $assume_yes != 1 ]] || { err '非交互模式缺少参数：证书域名（--domain）'; return 1; }
        cert_domain_confirm 1 || return 3
        checked=$opt_sni
    fi
    if [[ $assume_yes != 1 ]] && proto_has "$type" variant && [[ -z $opt_transport$opt_proto_version$opt_proto_mode ]]; then
        proto_call "$type" variant || return 3
        questions=$((questions+1))
    fi
    port=${opt_port:-random}
    if [[ -z $opt_port && $assume_yes != 1 ]]; then
        while :; do
            ask '端口（1–65535，回车随机选一个空闲端口）' 随机 || return 3
            if [[ $REPLY == 随机 ]]; then port=random; break; fi
            if valid_port "$REPLY" && port_free "$REPLY"; then port=$REPLY; break; fi
            err '端口要在 1–65535 之间，并且没有被占用。'
        done
        questions=$((questions+1))
    fi
    if [[ $port != random ]]; then valid_port "$port" || { err '端口必须在 1–65535。'; return 1; }; fi
    name=$(default_node_name "$type${PUBLIC_LOC:+-$PUBLIC_LOC}")
    if [[ -n $opt_name ]]; then name=$opt_name
    elif [[ $assume_yes != 1 ]] && (( questions < 2 )); then ask '节点名称' "$name" || return 3; name=$REPLY; fi
    # Paths that only the command line chose a method for (--cert webroot / import).
    if [[ $assume_yes != 1 ]]; then
        case $opt_cert in
          webroot) [[ -n $opt_webroot ]] || { ask '现有网站根目录绝对路径' || return 3; opt_webroot=$REPLY; };;
          import)
            [[ -n $opt_cert_file ]] || { ask '完整证书链绝对路径' || return 3; opt_cert_file=$REPLY; }
            [[ -n $opt_key_file ]] || { ask '私钥绝对路径' || return 3; opt_key_file=$REPLY; };;
        esac
    fi
    # The questions are over; protocol options take their defaults without asking.
    saved=$assume_yes; assume_yes=1
    proto_call "$type" prompt || { assume_yes=$saved; return 1; }
    assume_yes=$saved
    [[ -z $sni ]] || valid_domain "$sni" || { err '域名不合法，请使用 ASCII/Punycode 域名。'; return 1; }
    [[ -z $opt_transport || -n $stream ]] || { err "--transport 不适用于 $(proto_call "$type" label)。"; return 1; }
    [[ -z $opt_proto_version$opt_proto_mode || -n $proto_version ]] || { err "--proto-version、--proto-mode 不适用于 $(proto_call "$type" label)。"; return 1; }
    case ${opt_bbr:-keep} in 1|enable) bbr=enable;; 2|keep) bbr=keep;; *) err '--bbr 只能是 enable 或 keep。'; return 1;; esac
    # A domain from the command line is checked here, still before any certificate request.
    while [[ $mode == auto && -n $sni && $sni != "$checked" ]] && ! cert_reusable "$sni"; do
        if [[ $assume_yes == 1 ]]; then
            domain_resolves_here "$sni" "$host" || { err '没有申请证书。域名开了 CDN 代理时，改用 --cert webroot 或 --cert import。'; return 1; }
            break
        fi
        opt_sni=$sni
        cert_domain_confirm 0 || return 3
        checked=$opt_sni
        # Another domain was typed: the protocol options follow it.
        saved=$assume_yes; assume_yes=1
        proto_call "$type" prompt || { assume_yes=$saved; return 1; }
        assume_yes=$saved
    done
    msg "部署：$name / $(proto_call "$type" label) / $host:${port/#random/随机端口}${sni:+ / $sni}"
    [[ -f $SRM_ROOT/.srm-owned ]] || setup "$self" || return 1
    ensure_dependencies || return 1
    transport=$(proto_call "$type" transport) || return 1
    [[ " $transport " != *" tcp "* || $port == random ]] || cert_avoid_port=$port
    # Both 80 and 443 taken: the menu offers the other ways to get the certificate.
    if [[ $mode == auto && $assume_yes != 1 ]] && ! cert_reusable "$sni" && ! cert_auto_mode >/dev/null; then
        msg $'80 和 443 端口都有程序在用，Let\'s Encrypt 没法自动验证域名：\n  1. 用现有网站目录验证（网站保持运行）\n  2. 导入已有证书\n  0. 返回'
        ask '请选择' 1 || return 3
        case $REPLY in
          1) mode=webroot; ask '现有网站根目录绝对路径' || return 3; webroot=$REPLY;;
          2) mode=import; ask '完整证书链绝对路径' || return 3; cert=$REPLY; ask '私钥绝对路径' || return 3; key=$REPLY;;
          *) err '无效选项。'; return 3;;
        esac
    fi
    [[ $mode != auto && $mode != webroot ]] || msg "证书由 Let's Encrypt 免费签发；继续表示同意该机构的服务条款。"
    if [[ $port == random ]]; then port=$(choose_port) || return 1; else port_free "$port" || { err '端口被占用，原服务未改动。'; return 1; }; fi
    cert_port_ok "$port" "$transport" || return 1
    [[ " $transport " != *" tcp "* ]] || cert_avoid_port=$port
    id=$(random_hex 8) || return 1
    proto_call "$type" create || return 1
    # A reused certificate may validate on this node's port.
    if [[ -n $(jq -r '.cert_dir // empty' <<< "$REPLY") ]] && ! cert_port_ok "$port" "$transport" "$sni"; then
        msg '证书已经申请好，换一个端口重新部署时会直接复用。'; return 1
    fi
    node=$(jq -n --arg id "$id" --arg name "$name" --arg host "$host" --arg sni "$sni" --arg type "$type" --argjson port "$port" --argjson fields "$REPLY" \
        '{id:$id,name:$name,host:$host} + (if $sni == "" then {} else {sni:$sni} end) + {port:$port,type:$type,enabled:true} + $fields') || return 1
    if [[ $(sysctl -n net.ipv6.conf.all.disable_ipv6 2>/dev/null) == 1 ]]; then
        node=$(printf '%s' "$node" | jq '.listen="0.0.0.0"') || return 1
    fi
    candidate=$(new_candidate) || return 1
    tmp=$(mktemp) || return 1
    jq --argjson n "$node" '.nodes += [$n]' "$candidate" > "$tmp" && mv "$tmp" "$candidate" || return 1
    if [[ -f $STATE ]] && jq -e 'any(.nodes[]; .enabled)' "$STATE" >/dev/null 2>&1; then
        msg '应用新配置会重启服务，已有节点的连接会断开几秒。'
    fi
    if apply_state "$candidate"; then
        rm -f "$candidate"
        if [[ $bbr == enable ]]; then
            if [[ $(sysctl -n net.ipv4.tcp_congestion_control) == bbr ]]; then msg 'BBR 已开启。'; else bbr_enable || msg '节点已部署；BBR 未启用，原因见上方。'; fi
        fi
        DEPLOYED_NODE=$node
        printf '%s' "$node" | deploy_summary
        if [[ $assume_yes != 1 ]]; then printf '按回车继续' >&2; IFS= read -r _ || true; fi
        return 0
    fi
    # A self-signed certificate made for this node is unused once the deploy fails.
    rm -rf "$DATA/selfsigned/$id"
    rm -f "$candidate"; return 1
}
# One screen after deploying: address, cloud firewall, link and QR code, and the
# snippet of every client that supports the protocol (node JSON on stdin).
deploy_summary() {
    local node transport port
    node=$(cat)
    port=$(jq -r .port <<< "$node")
    transport=$(proto_call "$(jq -r .type <<< "$node")" transport | tr '[:lower:] ' '[:upper:]+')
    msg ''
    msg "━━━━━━━━ 部署完成：$(jq -r .name <<< "$node")（$(proto_call "$(jq -r .type <<< "$node")" label)）━━━━━━━━"
    msg "服务器：$(jq -r .host <<< "$node")    端口：$port/$transport    节点 ID：$(jq -r .id <<< "$node")"
    msg "云服务器安全组：连不上时，到服务商控制台的安全组（云防火墙）放行入站 $transport $port；本机的 UFW / firewalld 已自动放行。"
    client_snippets qr <<< "$node"
    msg '以后在菜单里选「2. 节点管理」可以再次查看链接、二维码和这些配置。'
}
# Client configurations of the node on stdin, one section per supported client;
# with "qr" the share link is also drawn as a QR code (locally, no network).
client_snippets() {
    local node type clients link out client
    node=$(cat)
    type=$(jq -r .type <<< "$node")
    clients=$(proto_call "$type" link_clients) || return 1
    if [[ -n $clients ]]; then
        link=$(share_uri <<< "$node") || return 1
        msg $'\n── 分享链接 ──'
        msg "$link"
        if [[ ${1:-} == qr ]]; then
            if command -v qrencode >/dev/null; then
                if use_color; then qrencode -t ANSIUTF8 <<< "$link"; else qrencode -t UTF8 <<< "$link"; fi
            else msg '（未安装 qrencode，没有二维码。）'; fi
        fi
    fi
    out=$(surge_proxy <<< "$node") || return 1
    if [[ -n $out ]]; then
        msg $'\n── Surge：手机版新建代理后按下面逐项填写 ──'
        surge_form <<< "$out" || return 1
        msg 'Mac 版或在配置文本里编辑：把下面整行放进配置的 [Proxy] 段'
        msg "$out"
    fi
    out=$(clash_proxy <<< "$node") || return 1
    [[ -z $out ]] || { msg $'\n── Clash Meta (mihomo)：放进 proxies: 列表 ──'; msg "$out"; }
    msg $'\n── sing-box：放进 outbounds 列表 ──'
    client_outbound <<< "$node" || return 1
    for client in $clients; do
        msg ''
        client_import_hint "$client"
    done
    out=$(jq -r '.cert_sha256 // empty' <<< "$node")
    [[ -z $out ]] || msg $'\n'"自签证书：以上 Surge、Clash Meta、sing-box 配置已带证书指纹；只导入链接的客户端会跳过证书校验，客户端能填证书 SHA-256 指纹时填：$out"
    out=$(client_note <<< "$node") || return 1
    [[ -z $out ]] || msg $'\n'"说明：$out"
    if [[ $(proto_call "$type" transport) == udp ]]; then
        msg $'\n'"只走 UDP：Shadowrocket 等客户端的 TCP 延迟测试对这个节点显示不出延迟，属于正常；连不上多半是本地网络限制了 UDP，可以在菜单里选「1. 添加节点」换 TCP 类协议（VLESS Reality、AnyTLS）。"
    fi
}
client_import_hint() {
    case $1 in
      Shadowrocket) msg '── Shadowrocket：扫上面的二维码，或复制分享链接后打开 Shadowrocket，会提示从剪贴板添加 ──';;
      v2rayN) msg '── v2rayN：复制分享链接，在 v2rayN 主界面按 Ctrl+V（从剪贴板导入分享链接）──';;
    esac
}
# `srm add --json`: the deploy summary as one object; clients the protocol does not
# support are absent.
deploy_json() {
    local node type link='' clients surge clash outbound
    node=$(cat)
    type=$(jq -r .type <<< "$node")
    clients=$(proto_call "$type" link_clients) || return 1
    [[ -z $clients ]] || link=$(share_uri <<< "$node") || return 1
    surge=$(surge_proxy <<< "$node") && outbound=$(client_outbound <<< "$node") || return 1
    clash=$(jq -c "$PROTO_JQ_DEFS $(proto_jq clash empty)" <<< "$node") || return 1
    jq -n --argjson node "$node" --arg label "$(proto_call "$type" label)" --arg transport "$(proto_call "$type" transport)" \
      --arg link "$link" --arg clients "$clients" --arg surge "$surge" --arg clash "${clash:-null}" --argjson outbound "$outbound" \
      --arg note "$(client_note <<< "$node")" '
      ($clients|split(" ")|map(select(. != ""))) as $apps |
      {id:$node.id,name:$node.name,type:$node.type,protocol:$label,host:$node.host,port:$node.port,
       firewall:[$transport|split(" ")[]|{port:$node.port,protocol:.}],
       share_link:(if $link == "" then null else $link end),
       clients:({}
         + (if $surge == "" then {} else {surge:$surge} end)
         + (($clash|fromjson) as $c|if $c == null then {} else {clash_meta:$c} end)
         + {sing_box:$outbound}
         + (if any($apps[]; . == "Shadowrocket") then {shadowrocket:$link} else {} end)
         + (if any($apps[]; . == "v2rayN") then {v2rayn:$link} else {} end))}
      + (if $node.cert_sha256 then {cert_sha256:$node.cert_sha256} else {} end)
      + (if $note == "" then {} else {note:$note} end)'
}
# Another node of the same protocol gets a numbered default name: <type>, <type>-2, …
default_node_name() {
    local name=$1 n=1
    [[ -f $STATE ]] || { printf '%s\n' "$name"; return 0; }
    while jq -e --arg n "$name" 'any(.nodes[]; .name == $n)' "$STATE" >/dev/null; do
        n=$((n+1)); name=$1-$n
    done
    printf '%s\n' "$name"
}
# Viewing nodes never touches the network: links and QR codes are built locally.
export_node() {
    local id=$1 format=$2 node type link
    node=$(node_json "$STATE" "$id") || { err '节点不存在。'; return 1; }
    type=$(printf '%s' "$node" | jq -r .type)
    case $format in
      uri) printf '%s' "$node" | share_uri;;
      qr)
        link=$(printf '%s' "$node" | share_uri) || return 1
        if command -v qrencode >/dev/null; then
            if use_color; then printf '%s' "$link" | qrencode -t ANSIUTF8; else printf '%s' "$link" | qrencode -t UTF8; fi
        else msg '未安装 qrencode，只显示链接：'; msg "$link"; fi;;
      outbound) printf '%s' "$node" | client_outbound;;
      clash) printf '%s' "$node" | clash_proxy;;
      surge) printf '%s' "$node" | surge_proxy;;
      clients) printf '%s' "$node" | client_snippets;;
      details)
        printf '%s' "$node" | jq "del($(proto_call "$type" secrets))" || return 1
        if [[ $(printf '%s' "$node" | jq -r '.cert_dir // empty') ]]; then
            openssl x509 -in "$(printf '%s' "$node" | jq -r .cert_dir)/fullchain.pem" -noout -subject -enddate
        fi;;
      *) err '格式只能是 uri、qr、outbound、clash、surge、clients 或 details。'; return 1;;
    esac
}
list_nodes() {
    [[ -f $STATE ]] || { msg '尚无节点。'; return 0; }
    jq -r '.nodes[]|[.id,.name,.type,(.port|tostring),(if .enabled then "启用" else "停用" end)]|@tsv' "$STATE"
}
node_change() {
    local id=$1 action=$2 value=${3:-} candidate tmp type node dropped='' name local_port
    candidate=$(new_candidate) || return 1
    node=$(node_json "$candidate" "$id") || { rm -f "$candidate"; err '节点不存在。'; return 1; }
    type=$(printf '%s' "$node" | jq -r .type)
    tmp=$(mktemp) || return 1
    case $action in
      toggle)
        if [[ $(printf '%s' "$node" | jq -r .enabled) == false ]]; then
            port_free "$(printf '%s' "$node" | jq -r .port)" "$id" || { rm -f "$tmp" "$candidate"; err '端口被占用，无法启用。'; return 1; }
            # A helper's loopback port may have been taken while the node was off.
            local_port=$(printf '%s' "$node" | jq -r '.local_port // empty')
            if [[ -n $local_port && -n $(ss -H -ltn "sport = :$local_port") ]]; then
                rm -f "$tmp" "$candidate"; err "本机端口 $local_port 已被其他程序占用，无法启用；请删除此节点后重新部署。"; return 1
            fi
            cert_port_ok "$(printf '%s' "$node" | jq -r .port)" "$(proto_call "$type" transport)" || { rm -f "$tmp" "$candidate"; return 1; }
        fi
        jq --arg id "$id" '(.nodes[]|select(.id==$id)|.enabled) |= not' "$candidate" > "$tmp";;
      delete)
        # Rules limited to this node lose it; a rule left with no node goes too.
        dropped=$(jq -r --arg id "$id" '.policies[]|select(.inbounds == [$id])|.name' "$candidate") || dropped=''
        jq --arg id "$id" '.nodes |= map(select(.id!=$id)) |
          .policies |= map(if .inbounds then .inbounds -= [$id] else . end | select(.inbounds != []))' "$candidate" > "$tmp";;
      port)
        port_free "$value" "$id" || { rm -f "$tmp" "$candidate"; err '端口无效或被占用。'; return 1; }
        cert_port_ok "$value" "$(proto_call "$type" transport)" || { rm -f "$tmp" "$candidate"; return 1; }
        jq --arg id "$id" --argjson p "$value" '(.nodes[]|select(.id==$id)|.port)=$p' "$candidate" > "$tmp";;
      name)
        [[ -n $value ]] || { rm -f "$tmp" "$candidate"; err '名称不能为空。'; return 1; }
        jq --arg id "$id" --arg name "$value" '(.nodes[]|select(.id==$id)|.name)=$name' "$candidate" > "$tmp";;
      retarget)
        proto_has "$type" retarget || { rm -f "$tmp" "$candidate"; err '此协议的节点不支持切换握手目标。'; return 1; }
        proto_call "$type" retarget "$node" "$value" || { rm -f "$tmp" "$candidate"; return 1; }
        [[ -n $REPLY ]] || { rm -f "$tmp" "$candidate"; return 0; }
        jq --arg id "$id" --argjson f "$REPLY" '(.nodes[]|select(.id==$id)) += $f' "$candidate" > "$tmp";;
      rotate)
        proto_call "$type" rotate || { rm -f "$tmp" "$candidate"; return 1; }
        jq --arg id "$id" --argjson f "$REPLY" '(.nodes[]|select(.id==$id)) += $f' "$candidate" > "$tmp";;
      *) rm -f "$tmp" "$candidate"; err '操作只能是 toggle、port、name、rotate、retarget 或 delete。'; return 1;;
    esac
    local rc=1
    if mv "$tmp" "$candidate" && apply_state "$candidate"; then
        rc=0
        while IFS= read -r name; do [[ -z $name ]] || msg "分流规则「$name」只作用于这个节点，已一并删除。"; done <<< "$dropped"
    fi
    rm -f "$candidate" "$tmp"
    return "$rc"
}
node_menu() {
    [[ -f $STATE ]] || { msg '尚无节点。'; return 0; }
    local count index=0 id name type port status
    count=$(jq '.nodes|length' "$STATE") || return 1
    (( count > 0 )) || { msg '尚无节点，请先部署。'; return 0; }
    msg $'\n已部署节点：'
    while IFS=$'\t' read -r name type port status; do
        index=$((index+1))
        printf '  %s. %s | %s | 端口 %s | %s\n' "$index" "$name" "$type" "$port" "$status"
    done < <(jq -r '.nodes[]|[.name,.type,(.port|tostring),(if .enabled then "启用" else "停用" end)]|@tsv' "$STATE")
    ask '节点序号（也可输入完整 ID；0 返回）' || return 0
    id=$REPLY
    if [[ $REPLY =~ ^[1-9][0-9]{0,5}$ ]] && (( REPLY <= count )); then
        id=$(jq -r --argjson i "$((REPLY-1))" '.nodes[$i].id' "$STATE") || return 1
    fi
    type=$(node_json "$STATE" "$id" | jq -r .type) || { err '节点不存在。'; return 1; }
    msg $'1.详情 2.原始分享链接 3.二维码 4.客户端配置（Surge / Clash Meta / sing-box / Shadowrocket / v2rayN）\n5.启用/停用 6.修改端口 7.重置凭据 8.修改名称 9.删除'
    ! proto_has "$type" retarget_select || msg "10.$(proto_call "$type" retarget_label)"
    ask '操作' 1 || return 0
    case $REPLY in
      1) export_node "$id" details;; 2) export_node "$id" uri;; 3) export_node "$id" qr;; 4) export_node "$id" clients;;
      5) with_lock node_change "$id" toggle;;
      6) ask '新端口' || return 0; with_lock node_change "$id" port "$REPLY";;
      7) yesno '旧凭据会失效，确认重置' && with_lock node_change "$id" rotate;;
      8) ask '新名称' || return 0; with_lock node_change "$id" name "$REPLY";;
      9) yesno '确认删除此节点' && with_lock node_change "$id" delete;;
      10)
        proto_has "$type" retarget_select || { err '此协议的节点不支持切换握手目标。'; return 1; }
        proto_call "$type" retarget_select || return 0
        msg '切换后需更新客户端的原始链接 / SNI；端口和凭据保持不变，应用时可能短暂中断本脚本节点。'
        if with_lock node_change "$id" retarget "$REPLY"; then
            msg '当前节点原始链接：'; export_node "$id" uri
        fi;;
      *) err '无效选项。';;
    esac
}
# Updates are manual: replacing sing-box or a program next to it restarts it and drops
# connections for a few seconds. A daily timer only looks up version numbers
# (update_check_run) and writes $DATA/update-check.json; the menu header reads that
# file and never reaches the network.
# Protocols whose server program srm downloads (registry program_* hooks).
program_types() {
    local type
    for type in $PROTOCOLS; do proto_has "$type" program_latest && printf '%s\n' "$type"; done
    return 0
}
program_labels() {
    local type out=''
    for type in $(program_types); do out+="${out:+ / }$(proto_call "$type" program_label)"; done
    printf '%s\n' "$out"
}
# Program variants (e.g. v6) that TYPE's nodes in the state use.
program_keys() {
    [[ -f $STATE ]] || return 0
    jq -r --arg t "$1" "$PROTO_JQ_DEFS .nodes[]|select(.type == \$t)|$(proto_jq program_key empty)" "$STATE" | sort -u
}
core_installed() { "$CORE" version 2>/dev/null | awk 'NR == 1 {print $3}'; }
update_item() {
    local newer=false
    [[ -z $4 ]] || ! version_newer "$4" "$3" || newer=true
    jq -c --arg n "$2" --arg c "$3" --arg l "$4" --argjson newer "$newer" \
        '. + [{name:$n,current:(if $c == "" then null else $c end),latest:(if $l == "" then null else $l end),newer:$newer}]' <<< "$1"
}
update_cache_write() {
    local tmp
    tmp=$(mktemp "$DATA/.update-check.XXXXXX") || return 1
    if printf '%s\n' "$1" > "$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$DATA/update-check.json"; then return 0; fi
    rm -f "$tmp"; return 1
}
# After a manual update the cached entry NAME runs VERSION; the hint goes away.
update_cache_mark() {
    local file=$DATA/update-check.json latest cache
    [[ -f $file ]] || return 0
    latest=$(jq -r --arg n "$1" '.items[]|select(.name == $n)|.latest // empty' "$file") || return 0
    local newer=false
    [[ -z $latest ]] || ! version_newer "$latest" "$2" || newer=true
    cache=$(jq --arg n "$1" --arg v "$2" --argjson newer "$newer" '(.items[]|select(.name == $n)) |= (.current = $v | .newer = $newer)' "$file") &&
        update_cache_write "$cache" || true
}
# The daily timer's job: looks up the newest versions and records them. It downloads
# no program, replaces no file other than the cache, restarts nothing and takes no
# lock (the lock would resume an interrupted change).
update_check_run() {
    owned_root || return 1
    local items='[]' errors=() release latest='' type key version keys lines label
    if release=$(core_release); then latest=${release% *}; else errors+=('sing-box：没有查到最新版本'); fi
    items=$(update_item "$items" sing-box "$(core_installed)" "$latest") || return 1
    for type in $(program_types); do
        keys=$(program_keys "$type")
        [[ -n $keys ]] || continue
        label=$(proto_call "$type" program_label)
        # shellcheck disable=SC2086 # one key per word
        lines=$(proto_call "$type" program_latest $keys) || true
        for key in $keys; do
            version=$(awk -F '\t' -v k="$key" '$1 == k {print $2}' <<< "$lines")
            [[ -n $version ]] || errors+=("$label $key：没有查到最新版本")
            items=$(update_item "$items" "$label $key" "$(proto_call "$type" program_current "$key")" "$version") || return 1
        done
    done
    local cache
    cache=$(jq -n --arg at "$(date '+%Y-%m-%d %H:%M')" --argjson items "$items" '{checked_at:$at,items:$items,errors:$ARGS.positional}' --args ${errors[@]+"${errors[@]}"}) &&
        update_cache_write "$cache" || return 1
    (( ${#errors[@]} == 0 ))
}
# "sing-box 1.14.1 → 1.14.3，Snell v6 …" from the cache; empty when nothing is newer.
update_hint() {
    [[ -f $DATA/update-check.json ]] && command -v jq >/dev/null || return 0
    jq -r '[.items[]?|select(.newer)|"\(.name) \(.current // "未知") → \(.latest)"]|join("，")' "$DATA/update-check.json" 2>/dev/null || true
}
update_summary() {
    local file=$DATA/update-check.json
    if systemctl is-enabled --quiet "$CHECK_UNIT.timer" 2>/dev/null; then
        msg '每日检查：已开启（每天凌晨只查一次版本号，不下载、不重启）'
    else msg '每日检查：已关闭'; fi
    if [[ ! -f $file ]]; then msg '还没有检查过新版本。'
    elif ! jq -r '"上次检查：\(.checked_at)",
          (.items[]|"  \(.name)：当前 \(.current // "未知")，最新 \(.latest // "未查到")\(if .newer then "（可更新）" else "" end)"),
          (.errors[]?|"  \(.)")' "$file" 2>/dev/null; then
        msg '检查记录无法读取，下次检查会重写。'
    fi
}
update_check_install() {
    cat > "/etc/systemd/system/$CHECK_UNIT.service" <<UNIT
[Unit]
Description=srm daily version check (version numbers only: no download, no restart)
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/srm update-check run
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=$DATA
CapabilityBoundingSet=
UNIT
    cat > "/etc/systemd/system/$CHECK_UNIT.timer" <<'UNIT'
[Unit]
Description=srm daily version check
[Timer]
OnCalendar=*-*-* 02:00:00
RandomizedDelaySec=4h
Persistent=true
[Install]
WantedBy=timers.target
UNIT
    systemctl daemon-reload
}
# On unless turned off in the menu; reinstalling keeps it off.
update_check_setup() {
    update_check_install || return 1
    [[ -e $DATA/update-check.off ]] || systemctl enable --now "$CHECK_UNIT.timer" >/dev/null 2>&1
}
update_check_set() {
    owned_root || return 1
    case $1 in
      on)
        rm -f "$DATA/update-check.off"
        update_check_setup || { err '每日检查开启失败。'; return 1; }
        msg '每日检查已开启：每天凌晨只查一次版本号，有新版本时在菜单顶部提示。';;
      off)
        touch "$DATA/update-check.off" || return 1
        systemctl disable --now "$CHECK_UNIT.timer" >/dev/null 2>&1 || { err '每日检查关闭失败。'; return 1; }
        rm -f "$DATA/update-check.json"
        msg '每日检查已关闭；需要时在菜单「5. 更新」里选「立即检查新版本」。';;
      *) err '每日检查只能是 on 或 off。'; return 1;;
    esac
}
# Under the lock. Programs of TYPE (or of every type) used by nodes: each variant is
# replaced only when a newer build downloads and verifies, then its enabled nodes'
# services restart; a failed health check puts the previous build back.
update_programs() {
    owned_root || return 1
    local type keys failures=0
    for type in $(program_types); do
        [[ -z ${1:-} || $1 == "$type" ]] || continue
        keys=$(program_keys "$type")
        if [[ -z $keys ]]; then msg "没有 $(proto_call "$type" program_label) 节点，不需要更新。"; continue; fi
        # shellcheck disable=SC2086 # one key per word
        update_program "$type" $keys || failures=1
    done
    return "$failures"
}
update_program() {
    local type=$1 label lines key latest current path tmp units unit failures=0
    shift
    label=$(proto_call "$type" program_label)
    # A variant missing from the lookup fails alone; the others still update.
    lines=$(proto_call "$type" program_latest "$@") || failures=1
    [[ -n $lines ]] || { err "$label 没有更新。"; return 1; }
    # fd 3: downloads and restarts must not read the remaining lines.
    while IFS=$'\t' read -r key latest <&3; do
        current=$(proto_call "$type" program_current "$key")
        if ! version_newer "$latest" "$current"; then
            msg "$label $key 已是最新版本 $current，不需要重启。"; update_cache_mark "$label $key" "$current"; continue
        fi
        path=$(proto_call "$type" program_path "$key")
        tmp=$(mktemp "${path%/*}/.candidate.XXXXXX") || return 1
        if ! proto_call "$type" program_fetch "$key" "$latest" "$tmp"; then
            rm -f "$tmp"; err "$label $key 保持 $current，没有替换。"; failures=1; continue
        fi
        cp -p "$path" "$path.previous" && mv -f "$tmp" "$path" || { rm -f "$tmp"; failures=1; continue; }
        # Services of the enabled nodes running this variant; none, or nodes stopped
        # with sing-box, means nothing to restart: they start the new build later.
        units=''
        if systemctl is-active --quiet "$SERVICE"; then
            units=$(jq -r --arg t "$type" --arg k "$key" "$PROTO_JQ_DEFS .nodes[]|select(.enabled and .type == \$t)|select(($(proto_jq program_key empty)) == \$k)|$(proto_jq sidecar empty)" "$STATE") || units=''
        fi
        local good=1
        for unit in $units; do restart_unit "$unit" || good=0; done
        if [[ $good == 1 ]] && { [[ -z $units ]] || service_healthy "$STATE"; }; then
            printf '%s\n' "$latest" > "${path%/*}/version"
            update_cache_mark "$label $key" "$latest"
            msg "$label $key 已从 $current 更新到 $latest。"
            [[ -n $units ]] || msg '没有正在运行的节点用它，不需要重启；节点下次启动时用新版本。'
            continue
        fi
        mv -f "$path.previous" "$path"
        for unit in $units; do restart_unit "$unit" || true; done
        err "$label $latest 启动后健康检查失败，已恢复 $current。"; failures=1
    done 3<<< "$lines"
    return "$failures"
}
# Called under the same flock as node/configuration changes. The new script's own
# updaters replace sing-box and the programs.
update_all() {
    owned_root || return 1
    local before after backup
    backup=$(mktemp "$SRM_ROOT/.update-before.XXXXXX") || return 1
    cp -p "$SRM_ROOT/manager.sh" "$backup" || return 1
    before=$(sha256 "$backup")
    if ! update_latest; then rm -f "$backup"; return 1; fi
    after=$(sha256 "$SRM_ROOT/manager.sh")
    local rc=0
    bash -c 'source "$1" && declare -F update_core update_programs >/dev/null || exit 3
             rc=0; update_core || rc=1; update_programs || rc=1; exit "$rc"' bash "$SRM_ROOT/manager.sh" || rc=$?
    # sing-box and the programs no longer follow the script's version: their own
    # failure (a lookup or a download) keeps the new script, only a script that does
    # not load is reverted.
    if [[ $rc == 3 && $before != "$after" ]]; then
        mv -f "$backup" "$SRM_ROOT/manager.sh" || return 1
        err '新脚本无法加载，管理脚本已恢复为更新前版本。'
    else rm -f "$backup"; fi
    [[ $rc == 0 ]] || { err '更新没有全部完成，原因见上方；没更新的部分保持原版本。'; return 1; }
}
# Restarting drops every connection: the menu asks "confirm / back" (back by default).
update_confirm() {
    [[ ${assume_yes:-0} != 1 ]] || return 0
    msg '更新需要重启服务，所有连接会断开几秒。'
    msg '  1. 确认更新'
    msg '  0. 返回'
    ask '请选择' 0 || return 1
    [[ $REPLY == 1 ]]
}
# TARGET: all, core, script, programs (all types) or one program type; menu choices
# and `srm update` both come here.
update_run() {
    local target=${1:-all}
    if [[ $target == script ]]; then with_lock update_latest; return; fi
    update_confirm || { msg '已返回，没有更新。'; return 0; }
    case $target in
      all) with_lock update_all;;
      core) with_lock update_core;;
      programs) with_lock update_programs;;
      *) with_lock update_programs "$target";;
    esac
}
update_menu() {
    local labels toggle=off
    labels=$(program_labels)
    msg $'\n更新（不会自动更新；更新 sing-box 或 '"$labels"$' 要重启服务，所有连接会断开几秒）'
    update_summary
    systemctl is-enabled --quiet "$CHECK_UNIT.timer" 2>/dev/null || toggle=on
    msg "
1. 全部更新（脚本、sing-box、$labels）
2. 只更新 sing-box
3. 只更新 $labels
4. 只更新脚本（不重启服务）
5. 立即检查新版本（只查版本号，不下载）
6. $(if [[ $toggle == off ]]; then printf '关闭'; else printf '开启'; fi)每日检查
7. 回滚配置
8. 回滚脚本
0. 返回"
    ask '请选择' || return 0
    case $REPLY in
      1) update_run all;;
      2) update_run core;;
      3) update_run programs;;
      4) update_run script;;
      5) update_check_run; update_summary;;
      6) with_lock update_check_set "$toggle";;
      7) yesno '恢复上一份配置（影响本脚本节点）' && with_lock rollback_config;;
      8) with_lock rollback_script;;
      *) err '无效选项。';;
    esac
}
restart_nodes() {
    owned_root || return 1
    [[ -f $STATE ]] || { err '请先部署节点。'; return 1; }
    if [[ $(jq '[.nodes[]|select(.enabled)]|length' "$STATE") == 0 ]]; then msg '没有启用的节点。'; return 0; fi
    "$CORE" check -c "$DATA/current/config.json" && sidecars_sync "$STATE" && restart_unit "$SERVICE" && service_healthy "$STATE"
}
# Moving a v3 installation (the v2ray-agent based install.sh) to srm. V3_ROOT is only
# ever read: nodes come from v3's sing-box configuration fragments (including the
# 30_–33_ multi-instance files) with their keys and certificates, and from protocols
# that kept files of their own (registry hook v3_scan). The registry hooks v3_import,
# v3_scan and v3_prepare hold everything protocol-specific.
V3_ROOT=/etc/v2ray-agent
V3_UNIT_DIR=/etc/systemd/system
# Crontab lines of v3 that renew certificates or update geo data and restart v3's
# services (reloadCore). Commented out after moving, never deleted, and only when
# nothing of v3 keeps running on them (V3_REMAINS).
V3_CRON_JOBS='RenewTLS UpdateGeo'
MIGRATE_MARK='# srm 迁移后停用：'
# What of v3 keeps running after the move: Xray, the website, or v3's sing-box service
# when none of its nodes moves (jq on the plan, a list of labels).
V3_REMAINS='[.skipped[]|select(.runs)|.label] + (if any(.skipped[]; .stops) and (any(.units[]; test("sing-box"))|not) then ["旧版 sing-box 服务（上面不能迁移的 sing-box 节点）"] else [] end)'
# Drop-in that keeps a taken-over unit of v3 from starting while srm runs its nodes:
# v3's RenewTLS / UpdateGeo restart its sing-box. `systemctl mask` refuses unit files
# in /etc/systemd/system, where v3 puts them; the assertion ends with srm's record, so
# removing srm (and DATA with it) frees the unit again.
V3_BLOCK=srm-migrated.conf
# Settings-only fragments of v3 that need nothing in srm.
V3_PLAIN_FILES='log.json sniff.json'
# Menu item while v3 is there and nothing has been moved yet; no network, no root
# files beyond a directory listing.
migrate_pending() {
    [[ -d $V3_ROOT && ! -f $DATA/migrated-v3.json ]] || return 1
    compgen -G "$V3_ROOT/sing-box/conf/config/*.json" >/dev/null || compgen -G "$V3_ROOT/*/nodes/*.env" >/dev/null
}
# The first-screen question, unless a preview found nothing that can move (the item
# stays, for after the user fixed a reason shown there).
migrate_offered() { migrate_pending && [[ ! -f $DATA/migrate-v3-nothing ]]; }
# Reads V3_ROOT into the plan file $1: {nodes:[{node,label,cert,units,note}],skipped:[{label,reason}],units:[]}.
# Nodes get their final id here; host is set when applying.
migrate_scan() {
    local plan=$1 file base inbound conf=$V3_ROOT/sing-box/conf/config type line units=() i
    [[ -d $V3_ROOT ]] || { err "没有找到旧版安装（$V3_ROOT）。"; return 1; }
    printf '%s\n' '{"nodes":[],"skipped":[],"units":[]}' > "$plan" || return 1
    for file in "$conf"/*.json; do
        [[ -f $file ]] || continue
        base=${file##*/}
        if ! jq -e 'type == "object"' "$file" >/dev/null 2>&1; then migrate_skip "$plan" "$base" '文件无法解析'; continue; fi
        if jq -e '.inbounds|type == "array" and length > 0' "$file" >/dev/null; then
            while IFS= read -r inbound; do migrate_inbound "$plan" "$base" "$inbound" || return 1; done < <(jq -c '.inbounds[]' "$file")
        elif [[ " $V3_PLAIN_FILES " == *" $base "* ]] || { [[ $base == dns.json ]] && jq -e '(.dns.rules // [])|length == 0' "$file" >/dev/null; }; then
            continue
        else
            migrate_skip "$plan" "分流 / 出站设置 $base" 'v4 的分流按平台规则设置，不能自动迁移；迁移后在菜单「3. 流媒体分流」里重新设置'
        fi
    done
    # The sing-box service of v3 stops only when at least one of its nodes moves.
    if jq -e '.nodes|length > 0' "$plan" >/dev/null; then
        [[ ! -f $V3_UNIT_DIR/dodo258-sing-box.service ]] || units+=(dodo258-sing-box.service)
        # Older releases used the upstream unit name.
        ! grep -qF "$V3_ROOT/" "$V3_UNIT_DIR/sing-box.service" 2>/dev/null || units+=(sing-box.service)
    fi
    for type in $PROTOCOLS; do
        proto_has "$type" v3_scan || continue
        while IFS= read -r line; do
            [[ -n $line ]] || continue
            migrate_scanned "$plan" "$line" || return 1
        done < <(proto_call "$type" v3_scan "$V3_ROOT")
    done
    for file in "$V3_ROOT"/xray/conf/*.json; do
        [[ -f $file ]] || continue
        while IFS=$'\t' read -r type i; do
            migrate_skip "$plan" "Xray $type（端口 $i）" 'v4 只用 sing-box；旧 Xray 服务继续运行，迁移不会停掉它' runs
        done < <(jq -r '.inbounds[]?|select(.port != null and (.listen // "") != "127.0.0.1")|[.protocol,(.port|tostring)]|@tsv' "$file" 2>/dev/null)
    done
    [[ ! -d $V3_ROOT/website-manager ]] || migrate_skip "$plan" '网站' 'v4 不管理网站；nginx 和网站文件保持原样' runs
    if compgen -G "$V3_ROOT/subscribe*" >/dev/null; then
        migrate_skip "$plan" '订阅链接' 'v4 不提供订阅；已导入的节点照常可用，新设备请用菜单「2. 节点管理」里的分享链接'
    fi
    local tmp
    tmp=$(mktemp) || return 1
    jq --args '.units = ([$ARGS.positional[], .nodes[].units[]]|unique)' ${units[@]+"${units[@]}"} < "$plan" > "$tmp" && mv "$tmp" "$plan"
}
# migrate_skip PLAN LABEL REASON [stops|runs]: "stops" marks a node of v3's sing-box
# service, which stops with the service when other nodes move; "runs" something of v3
# that keeps running (Xray, the website) on v3's certificates and geo data.
migrate_skip() {
    local tmp
    tmp=$(mktemp) || return 1
    jq --arg l "$2" --arg r "$3" --arg k "${4:-}" '.skipped += [{label:$l,reason:$r} + (if $k == "" then {} else {($k):true} end)]' "$1" > "$tmp" && mv "$tmp" "$1"
}
# A node from a v3_scan line or from an inbound; checks what every node needs and adds it.
# LABEL NODE [CERT UNITS NOTE USERS]: USERS, names of all users of the v3 inbound.
migrate_add() {
    local plan=$1 label=$2 node=$3 cert=${4:-null} unit_list=${5:-[]} note=${6:-} users=${7:-[]} port id taken tmp check stops=''
    # Nodes without units of their own are served by v3's sing-box service.
    [[ $unit_list != '[]' ]] || stops=stops
    port=$(jq -r .port <<< "$node")
    valid_port "$port" || { migrate_skip "$plan" "$label" '端口无效' $stops; return 0; }
    taken=$([[ ! -f $STATE ]] || jq -r --argjson p "$port" '.nodes[]|select(.port == $p or .local_port == $p)|.name' "$STATE" | head -n 1)
    [[ -z $taken ]] || { migrate_skip "$plan" "$label" "端口 $port 已被 srm 的节点「$taken」使用" $stops; return 0; }
    taken=$(jq -r --argjson p "$port" '.nodes[].node|select(.port == $p or .local_port == $p)|.name' "$plan" | head -n 1)
    [[ -z $taken ]] || { migrate_skip "$plan" "$label" "端口 $port 和要迁移的节点「$taken」重复" $stops; return 0; }
    id=$(random_hex 8) || return 1
    node=$(jq -c --arg id "$id" --arg name "$(jq -r .type <<< "$node")-$port" '{id:$id,name:$name} + . + {enabled:true}' <<< "$node") || return 1
    if [[ $cert != null ]]; then node=$(jq -c --argjson c "$cert" --arg dir "$(migrate_cert_dir "$cert" "$id")" '. + {cert_dir:$dir} + ($c.pins // {})' <<< "$node") || return 1; fi
    # Anything v4 would refuse is reported now, not when applying.
    check=$(mktemp) || return 1
    jq -n --argjson n "$node" '{schema:2,nodes:[$n + {host:"192.0.2.1"}],policies:[],unlock_dns:null,egress:null}' > "$check"
    if ! validate_state "$check" 2>/dev/null; then rm -f "$check"; migrate_skip "$plan" "$label" '节点数据 v4 不接受（字段格式不符）' $stops; return 0; fi
    rm -f "$check"
    tmp=$(mktemp) || return 1
    jq --argjson n "$node" --arg l "$label" --argjson c "$cert" --argjson u "$unit_list" --arg note "$note" --argjson users "$users" \
        '.nodes += [{node:$n,label:$l,cert:$c,units:$u} + (if $note == "" then {} else {note:$note} end)
            + (if ($users|length) > 1 then {user:$users[0],lost_users:$users[1:]} else {} end)]' "$plan" > "$tmp" && mv "$tmp" "$plan"
}
migrate_scanned() {
    local plan=$1 line=$2 label
    label=$(jq -r .label <<< "$line") || return 1
    if jq -e 'has("skip")' <<< "$line" >/dev/null; then migrate_skip "$plan" "$label" "$(jq -r .skip <<< "$line")"; return; fi
    migrate_add "$plan" "$label" "$(jq -c .node <<< "$line")" null "$(jq -c .units <<< "$line")" "$(jq -r '.note // ""' <<< "$line")"
}
migrate_inbound() {
    local plan=$1 file=$2 in=$3 label port type rc fields='' reason='' cert=null note=''
    port=$(jq -r '.listen_port // empty' <<< "$in")
    label="$(jq -r '.type // "?"' <<< "$in")（端口 ${port:-?}，$file）"
    case $(jq -r '.listen // "::"' <<< "$in") in
      127.0.0.1|::1|localhost) migrate_skip "$plan" "$label" '只监听本机、由 nginx 转发的节点，v4 不使用 nginx' stops; return 0;;
    esac
    for type in $PROTOCOLS; do
        proto_has "$type" v3_import || continue
        rc=0; proto_call "$type" v3_import "$in" || rc=$?
        case $rc in 0) fields=$REPLY; break;; 2) reason=$REPLY; break;; esac
    done
    [[ -z $fields$reason ]] || label="$(proto_call "$type" label)（端口 $port，$file）"
    if [[ -n $reason ]]; then migrate_skip "$plan" "$label" "$reason" stops; return 0; fi
    [[ -n $fields ]] || { migrate_skip "$plan" "$label" 'v4 不支持这种节点' stops; return 0; }
    if jq -e '.tls.certificate_path' <<< "$in" >/dev/null; then
        migrate_cert "$type" "$(jq -r .tls.certificate_path <<< "$in")" "$(jq -r '.tls.key_path // ""' <<< "$in")" "$(jq -r '.sni // ""' <<< "$fields")" ||
            { migrate_skip "$plan" "$label" "$REPLY" stops; return 0; }
        cert=$REPLY
    fi
    # v4 nodes have one user each: the first one moves, the others are listed.
    migrate_add "$plan" "$label" "$(jq -c --arg t "$type" --argjson p "$port" '. + {type:$t,port:$p}' <<< "$fields")" "$cert" '[]' '' \
        "$(jq -c '[.users // []|to_entries[]|.value.name // .value.username // .value.email // "第 \(.key+1) 个用户"]' <<< "$in")"
}
# REPLY = the certificate of a TLS node: {kind:"ca",domain,cert,key} or, for a
# self-signed one (only protocols whose clients pin it), {kind:"self",cert,key,pins}.
# On failure REPLY is the reason.
migrate_cert() {
    local type=$1 cert=$2 key=$3 domain=$4 subject issuer pin pubkey
    [[ -r $cert && -r $key ]] || { REPLY="证书文件不存在：$cert"; return 1; }
    subject=$(openssl x509 -in "$cert" -noout -subject 2>/dev/null) && issuer=$(openssl x509 -in "$cert" -noout -issuer 2>/dev/null) ||
        { REPLY="证书无法读取：$cert"; return 1; }
    if [[ ${subject#subject=} == "${issuer#issuer=}" ]]; then
        [[ $(proto_call "$type" domain) == optional ]] || { REPLY='自签证书只能用于客户端能校验证书指纹的协议'; return 1; }
        cert_valid "$cert" "$key" "$domain" || { REPLY='自签证书与 SNI / 私钥不匹配，或已到期'; return 1; }
        pin=$(openssl x509 -in "$cert" -outform der | openssl dgst -sha256 | awk '{print $NF}') &&
            pubkey=$(openssl x509 -in "$cert" -pubkey -noout | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | openssl base64 -A) || return 1
        REPLY=$(jq -nc --arg c "$cert" --arg k "$key" --arg pin "$pin" --arg pub "$pubkey" '{kind:"self",cert:$c,key:$k,pins:{cert_sha256:$pin,pubkey_sha256:$pub}}')
        return 0
    fi
    valid_domain "$domain" && cert_valid "$cert" "$key" "$domain" || { REPLY="证书不是 $domain 的、已到期或与私钥不匹配"; return 1; }
    REPLY=$(jq -nc --arg d "$domain" --arg c "$cert" --arg k "$key" '{kind:"ca",domain:$d,cert:$c,key:$k}')
}
migrate_cert_dir() {
    if [[ $(jq -r .kind <<< "$1") == self ]]; then printf '%s\n' "$DATA/selfsigned/$2"
    else printf '%s\n' "$DATA/certs/$(jq -r .domain <<< "$1")/active"; fi
}
# What moves, what does not, and what applying does.
migrate_show() {
    local plan=$1 count
    msg "发现旧版（v3）安装：$V3_ROOT"
    count=$(jq '.nodes|length' "$plan")
    if [[ $count == 0 ]]; then msg $'\n没有可以迁移的节点。'
    else
        msg $'\n能迁移的节点（端口、密码和密钥都不变，正在用的客户端不用改）：'
        jq -r '.nodes|to_entries[]|"  \(.key+1). \(.value.label)"
            + (if .value.node.sni then " · \(.value.node.sni)" else "" end)
            + (if .value.cert.kind == "self" then " · 自签证书" else "" end)
            + (if .value.note then "\n     说明：\(.value.note)" else "" end)
            + (if .value.lost_users then "\n     这个端口有 \(.value.lost_users|length + 1) 个用户，v4 每个节点只能有一个用户，只迁移「\(.value.user)」。"
               + "\n     下面这些用户迁移后将无法连接：" + ([.value.lost_users[]|"\n       - \(.)"]|add) else "" end)' "$plan"
    fi
    if jq -e '.skipped|length > 0' "$plan" >/dev/null; then
        msg $'\n不能迁移：'
        jq -r '.skipped[]|"  - \(.label)：\(.reason)"' "$plan"
    fi
    [[ $count != 0 ]] || return 0
    msg $'\n迁移时会：'
    msg "  - 停止并停用旧服务：$(jq -r '.units|join("、")' "$plan")$(jq -r 'if any(.skipped[]; .stops) and any(.units[]; test("sing-box")) then "；上面不能迁移的旧 sing-box 节点随之停止" else "" end' "$plan")"
    msg "  - 禁止这些旧服务再启动：旧版脚本重启它们会失败，不会和 srm 抢端口"
    msg '  - 由 srm 在原端口启动这些节点；启动或健康检查失败就恢复旧服务'
    if jq -e "($V3_REMAINS)|length > 0" "$plan" >/dev/null; then
        msg "  - 保留旧版定时任务（${V3_CRON_JOBS// /、}）：继续运行的 $(jq -r "($V3_REMAINS)|join(\"、\")" "$plan") 还要靠它续期证书（$V3_ROOT/tls）、更新 geo 数据"
        # v3's renewal stops nginx first and starts it again only after reloadCore.
        if { [[ -d $V3_ROOT/website-manager ]] || command -v nginx >/dev/null; } && jq -e 'any(.units[]; test("sing-box"))' "$plan" >/dev/null && migrate_v3_restarts_singbox; then
            msg "    注意：旧版续期证书时会先停 nginx、再重启旧 sing-box，这一步会失败（提示「sing-box重启失败」）并提前结束，nginx 会停着（网站、经 nginx 转发的 Xray 节点和伪装页都打不开）；证书续期那天（到期前一天凌晨）过后请检查，打不开就运行 systemctl start nginx"
        fi
    else
        msg "  - 注释掉旧版定时任务（${V3_CRON_JOBS// /、}），行首加 #，不删除"
    fi
    if jq -e 'any(.nodes[]; .cert.kind == "ca")' "$plan" >/dev/null; then
        if migrate_renewable "$plan"; then
            msg "  - 证书改由 srm 续期：到期前 30 天自动向 Let's Encrypt 重新申请（用 80 或 443 端口验证）"
        else
            msg "  - 注意：迁移后 80 和 443 端口都被占用，srm 没法自动给迁移过来的证书重新申请；到期前请空出 80 端口，再在菜单「8. 证书管理」里选「立即检查续期」"
        fi
    fi
    msg "  - $V3_ROOT 里的文件一个字节都不改"
}
# Whether v3's reloadCore, which RenewTLS and UpdateGeo call, restarts v3's sing-box
# service (v3's readInstallType): without Xray always, with Xray only when sing-box
# serves Hysteria2, TUIC or socks5.
migrate_v3_restarts_singbox() {
    local s=$V3_ROOT/sing-box/conf/config x=$V3_ROOT/xray/conf
    if [[ -f $V3_ROOT/xray/xray ]]; then
        [[ -f $x/02_VLESS_TCP_inbounds.json || -f $x/02_trojan_TCP_inbounds.json || -f $x/07_VLESS_vision_reality_inbounds.json || -f $x/12_VLESS_XHTTP_inbounds.json ]] &&
            [[ -f $V3_ROOT/sing-box/sing-box ]] && [[ -f $s/06_hysteria2_inbounds.json || -f $s/09_tuic_inbounds.json || -f $s/20_socks5_inbounds.json ]]
    else
        [[ -f $V3_ROOT/sing-box/sing-box && -f $V3_ROOT/sing-box/conf/config.json ]]
    fi
}
# Whether a certificate request could validate on 80 or 443 once the nodes moved: the
# port is not used by any TCP node (srm's or moving) and nothing listens on it now.
# Cautious: a v3 node that stops with its service still counts as a listener.
migrate_renewable() {
    local taken port
    taken=" $({ [[ ! -f $STATE ]] || jq -r ".nodes[]|select(any(($(proto_jq_transports))[]; . == \"tcp\"))|.port" "$STATE"
               jq -r ".nodes[].node|select(any(($(proto_jq_transports))[]; . == \"tcp\"))|.port" "$1"; } | tr '\n' ' ') "
    for port in 80 443; do
        [[ $taken != *" $port "* && -z $(ss -H -ltn "sport = :$port" 2>/dev/null) ]] && return 0
    done
    return 1
}
# Menu: preview, then 「确认 / 返回」 (Enter = back).
migrate_menu() {
    local plan rc=0
    plan=$(mktemp) || return 1
    migrate_scan "$plan" && migrate_show "$plan" || rc=1
    if [[ $rc == 0 ]] && jq -e '.nodes|length > 0' "$plan" >/dev/null; then
        migrate_confirm "$plan" && { with_lock migrate_apply "$SRM_SELF" || rc=1; }
    elif [[ $rc == 0 && -d $DATA ]]; then
        # Nothing can move: the first screen stops asking; item 9 stays.
        date '+%F %T' > "$DATA/migrate-v3-nothing" || true
    fi
    rm -f "$plan"
    return "$rc"
}
# 「确认 / 返回」 after the preview of PLAN; Enter = back.
migrate_confirm() {
    local lost
    lost=$(jq '[.nodes[].lost_users // [] | .[]]|length' "$1") || return 1
    [[ $lost == 0 ]] || msg $'\n'"注意：上面列出的 $lost 个用户迁移后将无法连接。"
    msg $'\n  1. 确认迁移（服务会重启，连接断开几秒）\n  0. 返回'
    ask '请选择' 0 && [[ $REPLY == 1 ]]
}
# First screen of the menu while v3 is there and nothing has moved yet.
migrate_offer() {
    msg $'\n发现旧版节点（'"$V3_ROOT"$'），要迁移过来吗？\n  1. 是，先看看能迁移哪些\n  0. 否（以后在菜单「9. 迁移旧版节点」里也能迁移）'
    ask '请选择' 1 || return 0
    [[ $REPLY == 1 ]] || return 0
    migrate_menu || true
}
# srm migrate [--apply] [--yes] [--host ADDR]: a preview by default.
migrate_command() {
    local apply=0 assume_yes=0 opt_host='' plan rc=0
    while (( $# )); do
        case $1 in
          --apply) apply=1;;
          -y|--yes) assume_yes=1;;
          --host) [[ -n ${2:-} ]] || { err '--host 需要一个值。'; return 1; }; opt_host=$2; shift;;
          *) err '用法：srm migrate [--apply] [--yes] [--host 地址]'; return 1;;
        esac
        shift
    done
    require_root || return 1
    if [[ $apply == 0 ]]; then
        plan=$(mktemp) || return 1
        migrate_scan "$plan" && migrate_show "$plan" || rc=1
        [[ $rc != 0 ]] || msg $'\n以上只是预览，没有改动。加 --apply 执行迁移。'
        rm -f "$plan"; return "$rc"
    fi
    if [[ $assume_yes != 1 ]]; then
        plan=$(mktemp) || return 1
        migrate_scan "$plan" && migrate_show "$plan" && migrate_confirm "$plan" || rc=1
        rm -f "$plan"
        [[ $rc == 0 ]] || { err '没有迁移。'; return 1; }
    fi
    with_lock migrate_apply "$SRM_SELF"
}
# Under the lock, already confirmed. Old services stop only after the new configuration
# passed sing-box check; when srm cannot take over their ports, they come back.
migrate_apply() {
    local self=$1 plan candidate config tmp node unit host units=() created=() rc=0
    plan=$(mktemp) && candidate=$(mktemp) && config=$(mktemp) || return 1
    migrate_scan "$plan" || { rm -f "$plan" "$candidate" "$config"; return 1; }
    if ! jq -e '.nodes|length > 0' "$plan" >/dev/null; then rm -f "$plan" "$candidate" "$config"; err '没有可以迁移的节点。'; return 1; fi
    # Without the preview (--yes) the users that stay behind are still named.
    [[ ${assume_yes:-0} != 1 ]] || ! jq -e 'any(.nodes[]; .lost_users)' "$plan" >/dev/null ||
        err "注意：这些用户迁移后将无法连接（v4 每个节点只有一个用户）：$(jq -r '[.nodes[].lost_users // [] | .[]]|join("、")' "$plan")"
    host=${opt_host:-}
    if [[ -z $host ]]; then
        msg '检测本机公网 IP…'
        if detect_public_ip; then host=$PUBLIC_IP
        elif [[ ${assume_yes:-0} == 1 ]]; then rm -f "$plan" "$candidate" "$config"; err '没有检测到本机公网 IP，非交互模式缺少参数：--host'; return 1
        else
            while :; do
                ask '没有检测到本机公网 IP，请填写客户端连接用的 IP 或域名' || { rm -f "$plan" "$candidate" "$config"; return 1; }
                host=$REPLY; valid_host "$host" && break
                err '地址不合法，例如 203.0.113.5 或 vpn.example.com。'
            done
        fi
    fi
    valid_host "$host" || { rm -f "$plan" "$candidate" "$config"; err '地址不合法。'; return 1; }
    [[ -f $SRM_ROOT/.srm-owned ]] || setup "$self" || { rm -f "$plan" "$candidate" "$config"; return 1; }
    ensure_dependencies || { rm -f "$plan" "$candidate" "$config"; return 1; }
    # Programs and certificates first; nothing of v3 has been touched yet.
    while IFS= read -r node; do
        ! proto_has "$(jq -r .node.type <<< "$node")" v3_prepare || proto_call "$(jq -r .node.type <<< "$node")" v3_prepare "$(jq -c .node <<< "$node")" || rc=1
        [[ $rc == 0 ]] || break
        migrate_install_cert "$node" || { rc=1; break; }
        [[ $(jq -r '.cert.kind // ""' <<< "$node") != self ]] || created+=("$DATA/selfsigned/$(jq -r .node.id <<< "$node")")
    done < <(jq -c '.nodes[]' "$plan")
    if [[ $rc == 0 ]]; then
        tmp=$(new_candidate) || rc=1
        if [[ $rc == 0 ]]; then
            local listen='::'
            [[ $(sysctl -n net.ipv6.conf.all.disable_ipv6 2>/dev/null) != 1 ]] || listen=0.0.0.0
            jq --slurpfile p "$plan" --arg host "$host" --arg listen "$listen" \
                '.nodes += [$p[0].nodes[].node + {host:$host} + (if $listen == "::" then {} else {listen:$listen} end)]' "$tmp" > "$candidate" || rc=1
            rm -f "$tmp"
        fi
    fi
    # The whole configuration must pass before any old service stops.
    if [[ $rc == 0 ]] && ! { validate_state "$candidate" && render_config "$candidate" > "$config" && "$CORE" check -c "$config"; }; then
        err '迁移后的配置没有通过校验（节点数据或 sing-box check），旧服务没有停止。'; rc=1
    fi
    if [[ $rc != 0 ]]; then
        rm -rf "$plan" "$candidate" "$config" ${created[@]+"${created[@]}"}
        err '迁移没有执行，旧版节点保持原样。'; return 1
    fi
    while IFS= read -r unit; do [[ -z $unit ]] || units+=("$unit"); done < <(jq -r '.units[]' "$plan")
    # Interrupted from here on, the old services come back as well.
    trap 'migrate_restore_units; exit 130' INT TERM HUP
    migrate_stop_units ${units[@]+"${units[@]}"} || rc=1
    if [[ $rc == 0 ]]; then
        msg '应用新配置，srm 接管原端口…'
        apply_state "$candidate" || rc=1
    fi
    if [[ $rc != 0 ]]; then
        migrate_restore_units || err "旧服务没能全部恢复，请检查：systemctl status ${units[*]:-}"
        rm -rf "$plan" "$candidate" "$config" ${created[@]+"${created[@]}"}
        trap - INT TERM HUP
        err '迁移失败，已恢复旧服务；旧版节点保持原样。'; return 1
    fi
    trap - INT TERM HUP
    # The record also keeps the old units from starting (V3_BLOCK).
    jq -n --arg at "$(date '+%F %T')" --slurpfile p "$plan" '{migrated_at:$at,units:$p[0].units,nodes:[$p[0].nodes[].node.id]}' > "$DATA/migrated-v3.json" ||
        err "迁移记录 $DATA/migrated-v3.json 没能写入：旧版脚本仍可能启动旧服务，菜单也会再次提示迁移。"
    if jq -e "($V3_REMAINS)|length == 0" "$plan" >/dev/null; then
        migrate_cron || err '旧版定时任务没能注释掉，请手动在 crontab -e 里给它们的行首加 #。'
    fi
    if jq -e 'any(.nodes[]; .cert.kind == "ca")' "$plan" >/dev/null; then install_renew_timer || err '证书续期定时任务注册失败。'; fi
    msg $'\n迁移完成：'
    jq -r '.nodes[]|"  \(.node.name) · 端口 \(.node.port)"' "$plan"
    msg '在菜单「2. 节点管理」里能看到这些节点的分享链接、二维码和各客户端配置。'
    msg "旧版文件仍在 $V3_ROOT，没有改动；确认一切正常后可自行删除。"
    local vasma
    vasma=$(command -v vasma 2>/dev/null) || vasma=''
    [[ -z $vasma || $(readlink -f "$vasma") == "$SRM_ROOT/manager.sh" ]] || msg '旧版的 vasma 命令仍打开旧脚本，以后请输入 srm 打开菜单。'
    rm -f "$plan" "$candidate" "$config"
}
# Certificates the node needs inside srm's own directories (copies; v3 files stay as they are).
migrate_install_cert() {
    local entry=$1 kind dir tmp domain cert_rc
    kind=$(jq -r '.cert.kind // ""' <<< "$entry")
    case $kind in
      self)
        dir=$DATA/selfsigned/$(jq -r .node.id <<< "$entry")
        install -d -m 750 "$DATA/selfsigned" "$dir" && chgrp srm "$DATA/selfsigned" "$dir" &&
            install -m 640 "$(jq -r .cert.cert <<< "$entry")" "$dir/fullchain.pem" &&
            install -m 640 "$(jq -r .cert.key <<< "$entry")" "$dir/key.pem" && chgrp srm "$dir/fullchain.pem" "$dir/key.pem";;
      ca)
        domain=$(jq -r .cert.domain <<< "$entry")
        # A valid certificate srm already has for the domain stays.
        cert_reusable "$domain" && return 0
        tmp=$(mktemp -d) || return 1
        cp "$(jq -r .cert.cert <<< "$entry")" "$tmp/fullchain.pem" && cp "$(jq -r .cert.key <<< "$entry")" "$tmp/key.pem" && activate_cert "$domain" "$tmp" v3
        cert_rc=$?; rm -rf "$tmp"; return "$cert_rc";;
    esac
}
# Stops and disables UNITS and keeps them from starting (V3_BLOCK), remembering what
# each was, so migrate_restore_units can put them back. Disabled as well: a reboot must
# not start them next to srm.
MIGRATE_RESTORE=''
migrate_stop_units() {
    local unit active enabled
    MIGRATE_RESTORE=''
    for unit in "$@"; do
        active=0; enabled=0
        systemctl is-active --quiet "$unit" && active=1
        systemctl is-enabled --quiet "$unit" 2>/dev/null && enabled=1
        MIGRATE_RESTORE+="$unit $active $enabled"$'\n'
        msg "停止旧服务 $unit"
        if ! systemctl disable --now "$unit" >/dev/null 2>&1 && systemctl is-active --quiet "$unit"; then
            err "$unit 停不下来。"; return 1
        fi
        mkdir -p "$V3_UNIT_DIR/$unit.d" && printf '%s\n' \
            "# srm 已接管这个旧版服务的节点（$DATA/migrated-v3.json），旧版脚本不能再启动它。" \
            '# 要恢复旧版：删除本文件，运行 systemctl daemon-reload。' \
            '[Unit]' "AssertPathExists=!$DATA/migrated-v3.json" > "$V3_UNIT_DIR/$unit.d/$V3_BLOCK" || { err "$unit 没能禁止启动。"; return 1; }
    done
    (( $# == 0 )) || systemctl daemon-reload || { err 'systemctl daemon-reload 失败。'; return 1; }
}
migrate_restore_units() {
    local unit active enabled failures=0
    # Unblocked first (V3_BLOCK), so they can start again.
    while read -r unit active enabled; do
        [[ -n $unit ]] || continue
        migrate_unblock "$unit" || failures=1
    done <<< "$MIGRATE_RESTORE"
    [[ -z $MIGRATE_RESTORE ]] || systemctl daemon-reload || failures=1
    while read -r unit active enabled; do
        [[ -n $unit ]] || continue
        [[ $enabled == 0 ]] || systemctl enable "$unit" >/dev/null 2>&1 || failures=1
        if [[ $active == 1 ]]; then
            msg "恢复旧服务 $unit"
            systemctl start "$unit" && systemctl is-active --quiet "$unit" || failures=1
        fi
    done <<< "$MIGRATE_RESTORE"
    return "$failures"
}
migrate_unblock() { rm -f "$V3_UNIT_DIR/$1.d/$V3_BLOCK" && { rmdir "$V3_UNIT_DIR/$1.d" 2>/dev/null || true; }; }
# On uninstalling srm: the units it took over are no longer blocked (still disabled).
migrate_unblock_recorded() {
    local unit units=()
    [[ -f $DATA/migrated-v3.json ]] || return 0
    while IFS= read -r unit; do [[ -z $unit ]] || { migrate_unblock "$unit"; units+=("$unit"); }; done < <(jq -r '.units[]?' "$DATA/migrated-v3.json")
    (( ${#units[@]} == 0 )) || msg "迁移时停用的旧版服务仍是停用状态，要继续用旧版：systemctl enable --now ${units[*]}"
}
# Comments out v3's own cron jobs (V3_CRON_JOBS run by V3_ROOT/install.sh).
migrate_cron() {
    local current updated job pattern=''
    current=$(crontab -l 2>/dev/null) || return 0
    for job in $V3_CRON_JOBS; do pattern+="${pattern:+|}$job"; done
    updated=$(awk -v root="$V3_ROOT/install.sh" -v jobs="^($pattern)\$" -v mark="$MIGRATE_MARK" '
        { n = split($0, f, /[ \t]+/); hit = 0
          for (i = 1; i < n; i++) if (f[i] == root && f[i+1] ~ jobs) hit = 1
          if (hit && $0 !~ /^[ \t]*#/) print mark $0; else print }' <<< "$current") || return 1
    [[ $updated != "$current" ]] || return 0
    printf '%s\n' "$updated" | crontab - || return 1
    msg "已注释掉旧版定时任务（${V3_CRON_JOBS// /、}）。"
}
menu_header() {
    local status='未部署' counts='0 / 0' renew='未配置' routing='未启用' updates color='' reset=''
    if use_color; then color=$'\033[1;36m'; reset=$'\033[0m'; fi
    if [[ -f $SRM_ROOT/.srm-owned ]]; then
        status='已安装，服务未运行'
        systemctl is-active --quiet "$SERVICE" && status='运行中'
    fi
    if [[ -f $STATE ]] && command -v jq >/dev/null; then
        counts=$(jq -r '"\([.nodes[]|select(.enabled)]|length) / \(.nodes|length)"' "$STATE")
        routing=$(jq -r 'if (.policies|length)==0 then "未启用" else "\(.policies|length) 条平台规则" end' "$STATE")
    fi
    systemctl is-active --quiet srm-renew.timer && renew='每日自动检查'
    # Versions come from the daily check's cache; the menu never looks them up.
    updates=$(update_hint)
    printf '\n%s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n' "$color" "$reset"
    printf '  sing-box-reality-manager (srm)  v%s\n' "$SRM_VERSION"
    printf '  %s\n' "$(proto_labels 3)"
    printf '%s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n' "$color" "$reset"
    printf '  服务：%s    节点：%s（启用 / 总数）\n' "$status" "$counts"
    printf '  分流：%s    证书续期：%s\n' "$routing" "$renew"
    [[ -z $updates ]] || printf '  可更新：%s（选 5 更新）\n' "$updates"
    printf '\n'
}
main_menu() {
    require_linux || return 1
    # Leaving quick deploy without a node is fine here; `srm add` treats it as a failure.
    local IN_MENU=1
    # A v3 installation whose nodes have not moved: offered before anything else.
    if migrate_offered; then menu_header; migrate_offer; fi
    # No node yet: straight into quick deploy; 0 there shows the menu.
    if [[ ! -f $STATE ]] || ! jq -e '.nodes|length > 0' "$STATE" >/dev/null 2>&1; then
        menu_header
        with_lock node_add "$SRM_SELF"
    fi
    while :; do
        menu_header
        msg $'  1. 添加节点 · 快速部署\n  2. 节点管理 · 原始链接 / 二维码\n  3. 流媒体分流 · 解锁 DNS / 代理出口\n  4. 运行状态 · 日志 / 重启 / 防火墙\n  5. 更新 · 新版本检查 / 回滚\n  6. BBR 与系统检测\n  7. 卸载\n  8. 证书管理 · 到期时间 / 自动续期'
        ! migrate_pending || msg '  9. 迁移旧版节点 · 发现 v3 安装'
        msg $'\n  0. 退出\n'
        ask '请选择' || return 0
        case $REPLY in
          1) with_lock node_add "$SRM_SELF";;
          2) node_menu;;
          3) with_lock routing_menu;;
          4) status_menu;;
          5) update_menu;;
          6)
            bbr_status
            msg 'BBR 为主机级 TCP 设置。共存测试请保持现状。'
            yesno '当前内核支持时自动开启 BBR + FQ（不更换内核、不重启）' && with_lock bbr_enable;;
          7) with_lock uninstall; [[ -f $SRM_ROOT/.srm-owned ]] || return 0;;
          8) certificate_menu;;
          9) if migrate_pending; then migrate_menu; else err '无效选项。'; fi;;
          *) err '无效选项。';;
        esac
    done
}
status_menu() {
    show_status
    msg $'\n1.查看最近 50 行日志（分享前请检查敏感信息）\n2.重启本脚本节点（连接会断开几秒）\n3.重新同步防火墙端口规则\n0.返回'
    ask '请选择' || return 0
    case $REPLY in
      1) show_logs;;
      2) yesno '重启会断开所有连接几秒，确认重启' && with_lock restart_nodes;;
      3) with_lock firewall_sync "$STATE";;
      *) err '无效选项。';;
    esac
}
rollback_script() {
    owned_root || return 1
    [[ -f $SRM_ROOT/manager.previous.sh ]] || { err '没有可回滚的脚本版本。'; return 1; }
    bash -n "$SRM_ROOT/manager.previous.sh" && install -m 755 "$SRM_ROOT/manager.previous.sh" "$SRM_ROOT/manager.sh" && msg '脚本已回滚，请重新运行。'
}
usage() {
    cat <<EOF
srm $SRM_VERSION：sing-box 节点管理（$(proto_labels)）
用法：srm [命令] [参数]；任何命令加 --help 显示本帮助。
日常使用只需输入 srm 打开菜单，所有功能都能在菜单里选；下面的命令给进阶用户和自动化脚本。

  srm                     打开管理菜单（常驻，做完回到菜单，输入 0 返回或退出）
  srm menu                同上
  srm install             只安装运行环境（核心、服务、srm / vasma 命令）
  srm add [协议] [选项]   部署节点，协议：$PROTOCOLS；不写协议时打开快速部署列表
                            --port 端口|random  --domain 证书域名（需要证书的协议；先检查解析到本机）
                            --name 名称  --host 客户端连接的地址（默认自动检测本机公网 IP）
                            --yes（不提问，未给的选项用默认值）  --json（结果输出为 JSON，其余信息写到 stderr）
                            进阶：--sni 域名（Reality / ShadowTLS 的握手目标，或证书域名）
                            --cert auto|webroot|import|selfsigned（自签只用于客户端能校验证书指纹的协议）
                            --webroot 目录  --cert-file 文件  --key-file 文件  --email 邮箱
                            --transport tcp|ws|grpc|httpupgrade（只用于能选传输方式的协议）
                            --proto-version 6|5  --proto-mode default|unshaped（只用于 Snell：版本和 v6 模式）
                            --bbr enable|keep
  srm list                列出节点：ID、名称、协议、端口、状态
  srm nodes               节点管理菜单：原始链接、二维码、启停、改端口、重置凭据
  srm node ID 操作 [值]   toggle | delete | rotate | port 端口 | name 名称 | retarget 目标域名
  srm export ID [格式]    uri（默认）| qr | outbound（sing-box）| clash | surge | clients（全部客户端）| details
                          只在本机生成，不联网
  srm protocols           支持的协议和传输层
  srm routing [show]      流媒体分流菜单；show 只查看
  srm routing dns IP      设置解锁 DNS
  srm routing egress 地址 [端口] [用户名]   设置 SOCKS5 代理出口；有用户名时从标准输入读密码
  srm routing add 名称 dns|proxy 域名… [--nodes ID,…|all]
                          添加或替换平台规则（netflix.com 等域名后缀）；--nodes 只对这些节点生效，
                          all 对所有节点；不写时替换的规则保留原来的节点
  srm routing del 名称    删除平台规则
  srm certs [status]      证书管理；status 只查看
  srm renew               检查证书续期
  srm firewall            同步本脚本的 UFW / firewalld 端口规则
  srm status              运行状态
  srm logs                最近 50 行日志
  srm restart             重启本脚本节点
  srm rollback            恢复上一份节点配置
  srm rollback-script     恢复上一个版本的脚本
  srm bbr [status|on]     查看或开启 BBR + FQ
  srm update [core|$(program_types | tr '\n' '|')script] [--yes]
                          手动更新，不写为全部（脚本、sing-box、$(program_labels)）；core 只更新 sing-box，
                          $(program_types | paste -sd / -) 只更新 $(program_labels)，script 只更新脚本（不重启服务）；
                          更新 sing-box 或 $(program_labels) 会重启服务、断开连接几秒，--yes 跳过确认
  srm update-check [on|off|status|run]
                          每日检查新版本（只查版本号，不下载、不重启）：开启、关闭、查看（默认）、立即检查
  srm migrate [--apply] [--yes] [--host 地址]
                          迁移旧版（v3，$V3_ROOT）的节点：默认只预览能迁移和不能迁移的内容；
                          --apply 执行（停止旧服务，srm 在原端口接管，失败恢复旧服务），--yes 不再确认
  srm uninstall [--yes]   卸载（默认需要确认）
  srm render STATE        用 state 文件生成 sing-box 配置（调试用）
  srm version             版本
  srm help                本帮助
EOF
}
list_protocols() {
    local type
    for type in $PROTOCOLS; do printf '%s\t%s\t%s\n' "$type" "$(proto_call "$type" label)" "$(proto_call "$type" transport)"; done
}
main() {
    umask 077
    local arg assume_yes=0
    for arg in "$@"; do
        case $arg in --help|-h) usage; return 0;; esac
    done
    case ${1:-menu} in
      menu) main_menu;;
      # Installed from a terminal: the menu opens right away (quick deploy without nodes).
      install) with_lock setup "$SRM_SELF" || return 1; if [[ -t 0 && -t 1 ]]; then main_menu; fi;;
      add) shift; with_lock node_add "$SRM_SELF" "$@";;
      list) require_root && list_nodes;;
      nodes) require_linux && node_menu;;
      node)
        [[ -n ${2:-} && -n ${3:-} ]] || { err '用法：srm node ID toggle|delete|rotate|port 端口|name 名称|retarget 目标域名'; return 1; }
        with_lock node_change "$2" "$3" "${4:-}";;
      export) require_root && export_node "${2:-}" "${3:-uri}";;
      protocols) list_protocols;;
      routing)
        case ${2:-menu} in
          menu) with_lock routing_menu;; show) require_root && routing_show;;
          dns|egress|add|del) shift; with_lock routing_change "$@";;
          *) err '用法：srm routing [show|dns|egress|add|del]'; return 1;;
        esac;;
      certs)
        require_linux || return 1
        case ${2:-menu} in
          menu) certificate_menu;; status) certificate_status;;
          *) err '用法：srm certs [status]'; return 1;;
        esac;;
      renew) with_lock renew_certificates;;
      firewall) with_lock firewall_sync "$STATE";;
      status) require_linux && show_status;;
      logs) require_linux && show_logs;;
      restart) with_lock restart_nodes;;
      rollback) with_lock rollback_config;;
      rollback-script) with_lock rollback_script;;
      bbr)
        case ${2:-status} in
          status) require_linux && bbr_status;; on) with_lock bbr_enable;;
          *) err '用法：srm bbr [status|on]'; return 1;;
        esac;;
      update)
        local target=all
        shift
        while (( $# )); do
            case $1 in
              -y|--yes) assume_yes=1;;
              all|core|script) target=$1;;
              *)
                proto_has "$1" program_latest || { err "用法：srm update [core|$(program_types | tr '\n' '|')script] [--yes]"; return 1; }
                target=$1;;
            esac
            shift
        done
        require_linux && update_run "$target";;
      update-check)
        case ${2:-status} in
          on|off) with_lock update_check_set "$2";;
          status) require_linux && update_summary;;
          run) require_linux && update_check_run;;
          *) err '用法：srm update-check [on|off|status|run]'; return 1;;
        esac;;
      migrate) shift; migrate_command "$@";;
      uninstall)
        case ${2:-} in -y|--yes) assume_yes=1;; '') ;; *) err '用法：srm uninstall [--yes]'; return 1;; esac
        with_lock uninstall;;
      render)
        [[ -n ${2:-} ]] || { err '用法：srm render STATE'; return 1; }
        local state rc=1
        state=$(mktemp) || return 1
        state_upgrade "$2" > "$state" && render_config "$state" && rc=0
        rm -f "$state"; return "$rc";;
      version|--version) printf 'srm %s / tested core %s\n' "$SRM_VERSION" "$CORE_VERSION";;
      help) usage;;
      *) err "未知命令：$1。可用命令见 srm --help。"; return 1;;
    esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
