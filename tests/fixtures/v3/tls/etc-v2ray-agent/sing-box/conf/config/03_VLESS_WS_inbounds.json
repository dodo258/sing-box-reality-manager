{
  "inbounds": [
    {
      "type": "vless",
      "listen": "::",
      "listen_port": 33444,
      "tag": "VLESSWS",
      "users": [
        {
          "uuid": "00000000-0000-4000-8000-00000000000c",
          "name": "5e6f7081-VLESS_WS"
        }
      ],
      "tls": {
        "server_name": "vpn.example.com",
        "enabled": true,
        "certificate_path": "/etc/v2ray-agent/tls/vpn.example.com.crt",
        "key_path": "/etc/v2ray-agent/tls/vpn.example.com.key"
      },
      "transport": {
        "type": "ws",
        "path": "/qwerws",
        "max_early_data": 2048,
        "early_data_header_name": "Sec-WebSocket-Protocol"
      }
    }
  ]
}
